!define BLANK ""
c:\rdos\kernel\os\pe.obj : c:\rdos\kernel\os\pe.asm .AUTODEPEND
 @c:
 cd c:\rdos\kernel\os
 *wasm pe.asm -ms -2 -d1 -w4 -e25 -zq

c:\rdos\kernel\os\pe.rdv : c:\rdos\kernel\os\pe.obj .AUTODEPEND
 @c:
 cd c:\rdos\kernel\os
 @%write pe.lk1 FIL pe.obj
 @%append pe.lk1 
!ifneq BLANK ""
 *wlib -q -n -b pe.imp 
 @%append pe.lk1 LIBR pe.imp
!endif
!ifneq BLANK ""
 @%append pe.lk1 
!endif
 *wlink name pe d all sys rdos_dev op codesel=0x7A0 op m op maplines op v op&
 maxe=25 op symf @pe.lk1

