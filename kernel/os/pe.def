object_struc    STRUC

o_name                          DB 8 DUP(?)
o_virt_size                     DD ?
o_va                            DD ?
o_phys_size                     DD ?
o_phys_offset           DD ?
o_resv1                         DD ?,?,?
o_flags                         DD ?

object_struc    ENDS

lib_struc STRUC

lib_mod             module_struc <>

lib_header          DD ?
lib_objects         DD ?
lib_object_rva      DD ?
lib_file_pos        DD ?
lib_local_handle    DW ?
lib_org_eip         DD ?
lib_init_param      DW ?
lib_name            DB ?

lib_struc ENDS

pe_program_struc  STRUC

ppr_base                        program_struc <>

ppr_section_linear              DD ?
ppr_get_system_time_proc        DD ?
