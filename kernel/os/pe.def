peh_subsysminor                 DW ?
peh_resv6                               DD ?
peh_image_size                  DD ?
peh_header_size                 DD ?
peh_file_checksum               DD ?
peh_subsys                              DW ?
peh_dllflags                    DW ?
peh_stack_reserve_size  DD ?
peh_stack_commit_size   DD ?
