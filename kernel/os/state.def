; STATE.INC
; Common types for thread state
;
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

state_ep    STRUC
sep_offs    DQ ?
sep_sel     DW ?
state_ep    ENDS

state_struc	STRUC
st_id		DW ?
st_name		DB 32 DUP(?)
st_time		DD ?,?
st_list		DB 32 DUP(?)
st_offs 	DD ?
st_sel		DW ?
state_struc	ENDS

action_state_struc	STRUC
ast_id		DW ?
ast_name	DB 32 DUP(?)
ast_time	DD ?,?
ast_list	DB 32 DUP(?)
ast_action  DB 32 DUP(?)
ast_pos 	state_ep <>
ast_count   DW ?
ast_user    DB 64 * SIZE state_ep DUP(?)

action_state_struc	ENDS
