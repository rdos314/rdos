!define BLANK ""
C:\rdos\kernel\os\debugio.obj : C:\rdos\kernel\os\debugio.asm .AUTODEPEND
 @C:
 cd C:\rdos\kernel\os
 *wasm debugio.asm -ms -2 -fp3 -fpi87 -d1 -w4 -e25 -zq

C:\rdos\kernel\os\disasm.obj : C:\rdos\kernel\os\disasm.asm .AUTODEPEND
 @C:
 cd C:\rdos\kernel\os
 *wasm disasm.asm -ms -2 -fp3 -fpi87 -d1 -w4 -e25 -zq

C:\rdos\kernel\os\disnew.obj : C:\rdos\kernel\os\disnew.asm .AUTODEPEND
 @C:
 cd C:\rdos\kernel\os
 *wasm disnew.asm -ms -2 -fp3 -fpi87 -d1 -w4 -e25 -zq

C:\rdos\kernel\os\ipcdebug.obj : C:\rdos\kernel\os\ipcdebug.asm .AUTODEPEND
 @C:
 cd C:\rdos\kernel\os
 *wasm ipcdebug.asm -ms -2 -fp3 -fpi87 -d1 -w4 -e25 -zq

C:\rdos\kernel\os\kdebug.obj : C:\rdos\kernel\os\kdebug.asm .AUTODEPEND
 @C:
 cd C:\rdos\kernel\os
 *wasm kdebug.asm -ms -2 -fp3 -fpi87 -d1 -w4 -e25 -zq

C:\rdos\kernel\os\math.obj : C:\rdos\kernel\os\math.asm .AUTODEPEND
 @C:
 cd C:\rdos\kernel\os
 *wasm math.asm -ms -2 -fp3 -fpi87 -d1 -w4 -e25 -zq

C:\rdos\kernel\os\kdebug.rdv : C:\rdos\kernel\os\debugio.obj C:\rdos\kernel\&
os\disasm.obj C:\rdos\kernel\os\disnew.obj C:\rdos\kernel\os\ipcdebug.obj C:&
\rdos\kernel\os\kdebug.obj C:\rdos\kernel\os\math.obj .AUTODEPEND
 @C:
 cd C:\rdos\kernel\os
 @%write kdebug.lk1 FIL debugio.obj,disasm.obj,disnew.obj,ipcdebug.obj,kdebu&
g.obj,math.obj
 @%append kdebug.lk1 
 *wlink name kdebug d all sys rdos_dev op codesel=0x480 op datasel=0x488 op &
m op maplines op v op maxe=25 op symf @kdebug.lk1

