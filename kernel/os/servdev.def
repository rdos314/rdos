server_header   STRUC

serv_header_size    DD ?
serv_file_size      DD ?
serv_name           DB ?

server_header   ENDS

ldt_serv_struc STRUC

ldt_base                 ldt_struc <>

serv_big_avail_mem       DD ?
serv_small_avail_mem     DD ?

serv_big_used_mem        DD ?
serv_small_used_mem      DD ?

serv_big_section         section_typ <>
serv_small_section       section_typ <>

serv_gate_sel            DW ?

serv_gate_arr            DW serv_gate_entries DUP (?)

serv_dir_arr             DD ?

ldt_serv_struc ENDS
