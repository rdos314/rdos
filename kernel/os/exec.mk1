!define BLANK ""
C:\rdos\kernel\os\exec.obj : C:\rdos\kernel\os\exec.asm .AUTODEPEND
 @C:
 cd C:\rdos\kernel\os
 *wasm exec.asm -ms -2 -d1 -w4 -e25 -zq

C:\rdos\kernel\os\exec.rdv : C:\rdos\kernel\os\exec.obj .AUTODEPEND
 @C:
 cd C:\rdos\kernel\os
 @%write exec.lk1 FIL exec.obj
 @%append exec.lk1 
!ifneq BLANK ""
 *wlib -q -n -b exec.imp 
 @%append exec.lk1 LIBR exec.imp
!endif
!ifneq BLANK ""
 @%append exec.lk1 
!endif
 *wlink name exec d all sys rdos_dev op codesel=0x3F0 op datasel=0x3F8 op m &
op maplines op v op maxe=25 op symf @exec.lk1

