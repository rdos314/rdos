D:\rdos\kernel\os\legacy.rdv : D:\rdos\kernel\os\bios.obj D:\rdos\kernel\os\&
dosdev.obj D:\rdos\kernel\os\ems.obj D:\rdos\kernel\os\legacy.obj D:\rdos\ke&
rnel\os\multiplx.obj D:\rdos\kernel\os\timer.obj D:\rdos\kernel\os\v86bios.o&
bj D:\rdos\kernel\os\xms.obj .AUTODEPEND
 @D:
 cd D:\rdos\kernel\os
 @%write legacy.lk1 FIL bios.obj,dosdev.obj,ems.obj,legacy.obj,multiplx.obj,&
timer.obj,v86bios.obj,xms.obj
 @%append legacy.lk1 
!ifneq BLANK ""
 *wlib -q -n -b legacy.imp 
 @%append legacy.lk1 LIBR legacy.imp
!endif
!ifneq BLANK ""
 @%append legacy.lk1 
!endif
 *wlink name legacy d all sys rdos_dev op codesel=0x4A0 op datasel=0x4A8 op &
m op maplines op v op maxe=25 op symf @legacy.lk1

