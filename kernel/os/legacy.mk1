!define BLANK ""
D:\rdos\kernel\os\bios.obj : D:\rdos\kernel\os\bios.asm .AUTODEPEND
 @D:
 cd D:\rdos\kernel\os
 *wasm bios.asm -ms -2 -d1 -w4 -e25 -zq

