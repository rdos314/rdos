!define BLANK ""
C:\rdos\kernel\os\audio.obj : C:\rdos\kernel\os\audio.asm .AUTODEPEND
 @C:
 cd C:\rdos\kernel\os
 *wasm audio.asm -ms -2 -fp3 -fpi87 -d1 -w4 -e25 -zq

C:\rdos\kernel\os\fm.obj : C:\rdos\kernel\os\fm.asm .AUTODEPEND
 @C:
 cd C:\rdos\kernel\os
 *wasm fm.asm -ms -2 -fp3 -fpi87 -d1 -w4 -e25 -zq

C:\rdos\kernel\os\fmexp.obj : C:\rdos\kernel\os\fmexp.asm .AUTODEPEND
 @C:
 cd C:\rdos\kernel\os
 *wasm fmexp.asm -ms -2 -fp3 -fpi87 -d1 -w4 -e25 -zq

C:\rdos\kernel\os\fmsin.obj : C:\rdos\kernel\os\fmsin.asm .AUTODEPEND
 @C:
 cd C:\rdos\kernel\os
 *wasm fmsin.asm -ms -2 -fp3 -fpi87 -d1 -w4 -e25 -zq

C:\rdos\kernel\os\audio.rdv : C:\rdos\kernel\os\audio.obj C:\rdos\kernel\os\&
fm.obj C:\rdos\kernel\os\fmexp.obj C:\rdos\kernel\os\fmsin.obj .AUTODEPEND
 @C:
 cd C:\rdos\kernel\os
 @%write audio.lk1 FIL audio.obj,fm.obj,fmexp.obj,fmsin.obj
 @%append audio.lk1 
!ifneq BLANK ""
 *wlib -q -n -b audio.imp 
 @%append audio.lk1 LIBR audio.imp
!endif
!ifneq BLANK ""
 @%append audio.lk1 
!endif
 *wlink name audio d all sys rdos_dev op codesel=0x410 op datasel=0x418 op m&
 op maplines op v op maxe=25 op symf @audio.lk1

