!define BLANK ""
c:\rdos\kernel\os\dhcp.obj : c:\rdos\kernel\os\dhcp.asm .AUTODEPEND
 @c:
 cd c:\rdos\kernel\os
 *wasm dhcp.asm -ms -2 -d1 -w4 -e25 -zq

