!define BLANK ""
C:\rdos\kernel\os\pic.obj : C:\rdos\kernel\os\pic.asm .AUTODEPEND
 @C:
 cd C:\rdos\kernel\os
 *wasm pic.asm -ms -2 -d1 -w4 -e25 -zq

C:\rdos\kernel\os\pic.rdv : C:\rdos\kernel\os\pic.obj .AUTODEPEND
 @C:
 cd C:\rdos\kernel\os
 @%write pic.lk1 FIL pic.obj
 @%append pic.lk1 
!ifneq BLANK ""
 *wlib -q -n -b pic.imp 
 @%append pic.lk1 LIBR pic.imp
!endif
!ifneq BLANK ""
 @%append pic.lk1 
!endif
 *wlink name pic d all sys rdos_dev op codesel=0xA58 op m op maplines op v o&
p maxe=25 op symf @pic.lk1

