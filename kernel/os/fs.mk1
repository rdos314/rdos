!define BLANK ""
C:\rdos\kernel\os\dir.obj : C:\rdos\kernel\os\dir.asm .AUTODEPEND
 @C:
 cd C:\rdos\kernel\os
 *wasm dir.asm -ms -2 -d1 -w4 -e25 -zq

C:\rdos\kernel\os\file.obj : C:\rdos\kernel\os\file.asm .AUTODEPEND
 @C:
 cd C:\rdos\kernel\os
 *wasm file.asm -ms -2 -d1 -w4 -e25 -zq

C:\rdos\kernel\os\fs.obj : C:\rdos\kernel\os\fs.asm .AUTODEPEND
 @C:
 cd C:\rdos\kernel\os
 *wasm fs.asm -ms -2 -d1 -w4 -e25 -zq

C:\rdos\kernel\os\inifile.obj : C:\rdos\kernel\os\inifile.asm .AUTODEPEND
 @C:
 cd C:\rdos\kernel\os
 *wasm inifile.asm -ms -2 -d1 -w4 -e25 -zq

C:\rdos\kernel\os\memmap.obj : C:\rdos\kernel\os\memmap.asm .AUTODEPEND
 @C:
 cd C:\rdos\kernel\os
 *wasm memmap.asm -ms -2 -d1 -w4 -e25 -zq

C:\rdos\kernel\os\fs.rdv : C:\rdos\kernel\os\dir.obj C:\rdos\kernel\os\file.&
obj C:\rdos\kernel\os\fs.obj C:\rdos\kernel\os\inifile.obj C:\rdos\kernel\os&
\memmap.obj .AUTODEPEND
 @C:
 cd C:\rdos\kernel\os
 @%write fs.lk1 FIL dir.obj,file.obj,fs.obj,inifile.obj,memmap.obj
 @%append fs.lk1 
!ifneq BLANK ""
 *wlib -q -n -b fs.imp 
 @%append fs.lk1 LIBR fs.imp
!endif
!ifneq BLANK ""
 @%append fs.lk1 
!endif
 *wlink name fs d all sys rdos_dev op codesel=0x5B0 op datasel=0x5B8 op m op&
 maplines op v op maxe=25 op symf @fs.lk1

