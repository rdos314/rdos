; MODULE.DEF
; Module definitions
;
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

module_struc    STRUC

; IN  BX        Module sel
mod_free_dll_proc       DD ?

; IN  BX        Module sel
; IN  ES:EDI	Proc name
; OUT DS:ESI	Proc address
mod_get_proc_proc       DD ?

; IN  BX        Module sel
; IN  EAX		Resource handle
; IN  EDX		Resource type
; OUT DS:ESI	Resource address
mod_get_resource_proc   DD ?

; IN  BX        Module sel
; IN  ECX		Max name size
; IN  ES:EDI	Name buffer
; OUT EAX		Bytes copied
mod_get_name_proc       DD ?

; IN  ES        Wait object
; IN  BX        Module sel
mod_start_wait_for_debug_event_proc   DD ?

; IN  ES        Wait object
; IN  BX        Module sel
mod_stop_wait_for_debug_event_proc   DD ?

; IN  ES        Wait object
; IN  BX        Module sel
mod_is_debug_event_idle_proc   DD ?

; IN  BX        Module sel
; OUT AX        Thread ID
; OUT BL        Event type  
mod_get_debug_event_proc   DD ?

; IN  BX        Module sel
; IN  ES:()EDI	Event buffer
mod_get_debug_event_data_proc   DD ?

; IN  BX        Module sel
mod_clear_debug_event_proc   DD ?

; IN  BX        Module sel
; IN  AX        Thread ID
mod_continue_debug_event_proc   DD ?

mod_handle              DW ?
mod_next                DW ?
mod_list                DW ?
mod_key                 DB ?

module_struc    ENDS

