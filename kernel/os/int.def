int_seg	STRUC

vm_int_handlers		DD 100h DUP(?,?)

pm16_int_handlers	DD 100h DUP(?,?)
pm32_int_handlers	DD 100h DUP(?,?)

get_vm_int_handlers	DD 100h DUP(?,?)
set_vm_int_handlers	DD 100h DUP(?,?)

get_pm16_int_handlers	DD 100h DUP(?,?)
set_pm16_int_handlers	DD 100h DUP(?,?)

get_pm32_int_handlers	DD 100h DUP(?,?)
set_pm32_int_handlers	DD 100h DUP(?,?)

vm_reflect_ads		DD ?
vm_reflect_seg		DW ?

pm_reflect_ads		DD ?
pm_reflect_seg		DW ?

sim_int16_offs		DW ?
sim_int16_seg		DW ?

sim_int32_offs		DW ?
sim_int32_seg		DW ?

pm_to_vm_done_ads	DD ?
pm_to_vm_done_seg	DW ?

call_vm_ret_seg		DW ?
call_pm16_ret_sel	DW ?

v86_raw_offs		DW ?
v86_raw_seg             DW ?

int_seg_size		DB ?

int_seg	ENDS

vm_call_struc	STRUC

vcs_edi		DD ?
vcs_esi		DD ?
vcs_ebp		DD ?
vcs_res		DD ?
vcs_ebx		DD ?
vcs_edx		DD ?
vcs_ecx		DD ?
vcs_eax		DD ?
vcs_flags	DW ?
vcs_es		DW ?
vcs_ds		DW ?
vcs_fs		DW ?
vcs_gs		DW ?
vcs_ip		DW ?
vcs_cs		DW ?
vcs_sp		DW ?
vcs_ss		DW ?

vm_call_struc	ENDS


