!define BLANK ""
c:\rdos\kernel\os\apic.obj : c:\rdos\kernel\os\apic.asm .AUTODEPEND
 @c:
 cd c:\rdos\kernel\os
 *wasm apic.asm -ms -2 -d1 -w4 -e25 -zq

c:\rdos\kernel\os\apic.rdv : c:\rdos\kernel\os\apic.obj .AUTODEPEND
 @c:
 cd c:\rdos\kernel\os
 @%write apic.lk1 FIL apic.obj
 @%append apic.lk1 
!ifneq BLANK ""
 *wlib -q -n -b apic.imp 
 @%append apic.lk1 LIBR apic.imp
!endif
!ifneq BLANK ""
 @%append apic.lk1 
!endif
 *wlink name apic d all sys rdos_dev op codesel=0xA40 op datasel=0xA48 op m &
op maplines op maxe=25 op symf @apic.lk1

