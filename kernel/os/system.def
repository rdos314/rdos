phys_header_start    = 8
phys_bitmap_start    = 2000h

app_seg	STRUC

app_next			        DW ?

app_get_cmd_line_proc	    DD ?,?
app_get_exe_proc		    DD ?,?
app_get_env_proc		    DD ?,?
app_set_options_proc        DD ?,?
app_get_options_proc        DD ?,?
