;
; rom modules in RDOS
;

BootMemSign             EQU 675E4B72h
AllocMemSign    EQU 9AE58C5Dh

RdosSign EQU 5A1E75D4h

RdosKernel = 0
RdosFont = 1
RdosSimpleDevice = 2
RdosShutDown = 3
RdosOldFile = 6
RdosCommand = 7
RdosSet = 8
RdosPath = 9

RdosDosDevice = 16
RdosFile = 17

RdosDevice16 = 18
RdosDevice32 = 19
RdosLongMode = 20
RdosRealTime = 21
RdosServer = 22

RdosEnd = 0E5E5h

