tss_fs			DW ?,?
tss_gs			DW ?,?
tss_ldt			DW ?,?
tss_t			DW ?
tss_bitmap		DW ?
tss_dr0			DD ?
tss_dr1			DD ?
tss_dr2			DD ?
tss_dr3			DD ?
tss_dr7			DD ?
math_control	DW ?,?
math_status		DW ?,?
math_tag		DW ?,?
math_eip		DD ?
