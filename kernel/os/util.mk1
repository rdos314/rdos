!define BLANK ""
D:\rdos\kernel\os\env.obj : D:\rdos\kernel\os\env.asm .AUTODEPEND
 @D:
 cd D:\rdos\kernel\os
 *wasm env.asm -ms -2 -fp3 -fpi87 -d1 -w4 -e25 -zq

D:\rdos\kernel\os\time.obj : D:\rdos\kernel\os\time.asm .AUTODEPEND
 @D:
 cd D:\rdos\kernel\os
 *wasm time.asm -ms -2 -fp3 -fpi87 -d1 -w4 -e25 -zq

D:\rdos\kernel\os\util.obj : D:\rdos\kernel\os\util.asm .AUTODEPEND
 @D:
 cd D:\rdos\kernel\os
 *wasm util.asm -ms -2 -fp3 -fpi87 -d1 -w4 -e25 -zq

D:\rdos\kernel\os\wait.obj : D:\rdos\kernel\os\wait.asm .AUTODEPEND
 @D:
 cd D:\rdos\kernel\os
 *wasm wait.asm -ms -2 -fp3 -fpi87 -d1 -w4 -e25 -zq

D:\rdos\kernel\os\util.rdv : D:\rdos\kernel\os\env.obj D:\rdos\kernel\os\tim&
e.obj D:\rdos\kernel\os\util.obj D:\rdos\kernel\os\wait.obj .AUTODEPEND
 @D:
 cd D:\rdos\kernel\os
 @%write util.lk1 FIL env.obj,time.obj,util.obj,wait.obj
 @%append util.lk1 
!ifneq BLANK ""
 *wlib -q -n -b util.imp 
 @%append util.lk1 LIBR util.imp
!endif
!ifneq BLANK ""
 @%append util.lk1 
!endif
 *wlink name util d all sys rdos_dev op codesel=0xA70 op datasel=0xA78 op m &
op maplines op v op maxe=25 op symf @util.lk1

