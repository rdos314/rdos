!define BLANK ""
D:\rdos\kernel\os\font.obj : D:\rdos\kernel\os\font.asm .AUTODEPEND
 @D:
 cd D:\rdos\kernel\os
 *wasm font.asm -ms -2 -fp3 -fpi87 -d1 -w4 -e25 -zq

D:\rdos\kernel\os\font.rdv : D:\rdos\kernel\os\font.obj .AUTODEPEND
 @D:
 cd D:\rdos\kernel\os
 @%write font.lk1 FIL font.obj
 @%append font.lk1 
!ifneq BLANK ""
 *wlib -q -n -b font.imp 
 @%append font.lk1 LIBR font.imp
!endif
!ifneq BLANK ""
 @%append font.lk1 
!endif
 *wlink name font d all sys rdos_dev op codesel=0x710 op datasel=0x718 op m &
op maplines op maxe=25 op symf @font.lk1

