; DRIVER.DEF
; Device driver fixed GDT selectors. All selectors must be in the
; range 400h-0FFFh and the least 3 significant bits should be 0
;
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

;
; LDT system selectors
;

proc_handle_sel               EQU 7Ch

ldt_start       EQU 80h


;
; GDT system selectors
;

;
; do not change order for this, used in boot loader
;
