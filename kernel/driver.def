; DRIVER.DEF
; Device driver fixed GDT selectors. All selectors must be in the
; range 400h-0FFFh and the least 3 significant bits should be 0
;
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

;
; GDT system selectors
;

;
; do not change order for this, used in boot loader
;
idt_sel				EQU 8
gdt_sel				EQU 10h
device_code_sel		EQU 18h
flat_sel			EQU 20h

system_data_sel		EQU 28h
kernel_code			EQU 30h
;
shutdown_code_sel	EQU 38h

;
; processor core selector
;

core_data_sel       EQU 40h

double_tss_sel      EQU 48h
