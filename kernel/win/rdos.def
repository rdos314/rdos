NAME    RDOS
EXETYPE OS2
EXPORTS 
		AllocateDosMem	@1
		AllocateMem		@2
		FreeMem			@3
		AvailableMem	@4
		UsedMem			@5

		WaitTime		@100

		CreateThread		@300
		TerminateThread		@301
		
		SetTextMode				@500
		SetVgaMode				@501
		SetPage					@502
		SetColor				@503
		SetCursorPos			@504
		GetCursorPos			@505
		DisplayData				@506

		SetCurDrive				@600
		GetCurDrive				@601
		SetCurDir				@602
		GetCurDir				@603
		MakeDir					@604
		RemoveDir				@605
		DeleteFile				@606
