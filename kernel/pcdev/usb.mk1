!define BLANK ""
D:\rdos\kernel\pcdev\usb.obj : D:\rdos\kernel\pcdev\usb.asm .AUTODEPEND
 @D:
 cd D:\rdos\kernel\pcdev
 *wasm usb.asm -ms -2 -d1 -w4 -e25 -zq

D:\rdos\kernel\pcdev\usb.rdv : D:\rdos\kernel\pcdev\usb.obj .AUTODEPEND
 @D:
 cd D:\rdos\kernel\pcdev
 @%write usb.lk1 FIL usb.obj
 @%append usb.lk1 
 *wlink name usb d all sys rdos_dev op codesel=0x990 op datasel=0x998 op m o&
p maplines op v op maxe=25 op symf @usb.lk1

