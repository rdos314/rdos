!define BLANK ""
D:\rdos\kernel\pcdev\ac97.obj : D:\rdos\kernel\pcdev\ac97.asm .AUTODEPEND
 @D:
 cd D:\rdos\kernel\pcdev
 *wasm ac97.asm -ms -2 -d1 -w4 -e25 -zq

D:\rdos\kernel\pcdev\ac97.rdv : D:\rdos\kernel\pcdev\ac97.obj .AUTODEPEND
 @D:
 cd D:\rdos\kernel\pcdev
 @%write ac97.lk1 FIL ac97.obj
