 1234, "\r\n";
 1235, "The FreeDOS Command Shell developed by many developers, please refer\r\n";
 1236, "to the enclose HISTORY.TXT file.\r\n";
 1237, "\r\n";
 1238, "Currently maintained by Steffen Kaiser mailto:freecomfreedos.org\r\n";
 1239, "\r\n";
 1240, "Send bug reports to fd-freecomtopica.com.\r\n";
 1241, "Updates are available from http://freedos.sourceforge.net/freecom\r\n";
 1242, "\r\n";
 1243, "\r\n";
 1244, "\r\n";
 1245, "\r\n";
 1246, "The shell is about to be terminated, though, this is\r\n";
 1247, "\r\n";
 1248, "forbidden (usually by enabling the \"/P\" option).\r\n";
 1249, "\r\n";
 1250, "You must reboot the system or, if this shell runs in\r\n";
 1251, "\r\n";
 1252, "a multitasking environment, terminate this process/task manually.\r\n";
 1253, "\r\n";
 1254, "FreeCOM executable not found.\r\n";
 1255, "You must specify the complete path to COMMAND.COM\r\n";
 1256, "as the first argument of COMMAND, for instance:\r\n";
 1257, "C:\\FDOS\r\n";
 1258, "Environment segment    : max %5u bytes; free %5u bytes\r\n";
 1259, "Context segment        : max %5u bytes; free %5u bytes\r\n";
 1260, "Heap                   : free %5lu bytes\r\n";
 1261, "	Aliases        : limit %5u bytes, current %5u bytes, %5u items\r\n";
 1262, "	History        : limit %5u bytes, current %5u bytes, %5u items\r\n";
 1263, "	Directory stack: limit %5u bytes, current %5u bytes, %5u items\r\n";
 1264, "	Last dir cache : used  %5u bytes, %5u items\r\n";
 1265, "	Batch nesting  : used  %5u bytes, %5u items\r\n";
 1266, "	Swapinfo       : used  %5u bytes, %5u items\r\n";
 1267, "Failed to aquire current code page from system.\r\n";
 1268, "Failed to change current code page.\r\n";
 1269, "The current codepage is %u.\r\n";
 1270, "The system codepage (properly) is: %u.\r\n";
 1271, "Displays, sets, or removes aliases.\r\n";
 1272, "\r\n";
 1273, "ALIAS [variable[=][string]]\r\n";
 1274, "\r\n";
 1275, "	variable  Specifies the alias name.\r\n";
 1276, "	string    Specifies a series of characters to assign to the alias.\r\n";
 1277, "\r\n";
 1278, "\r\n";
 1279, "Type ALIAS without parameters to display the current aliases.\r\n";
 1280, "Make a beep sound.\r\n";
 1281, "Sets or clears extended CTRL+C checking.\r\n";
 1282, "\r\n";
 1283, "BREAK [ON | OFF]\r\n";
 1284, "\r\n";
 1285, "Type BREAK without a parameter to display the current BREAK setting.\r\n";
 1286, "Calls one batch program from another.\r\n";
 1287, "\r\n";
 1288, "CALL [drive:][path]filename [batch-parameters]\r\n";
 1289, "\r\n";
 1290, "  batch-parameters   Specifies any command-line information required by\r\n";
 1291, "                     the batch program.\r\n";
 1292, "Displays the name of or changes the current directory.\r\n";
 1293, "\r\n";
 1294, "CHDIR [drive:][path]\r\n";
 1295, "CHDIR[..]\r\n";
 1296, "CD [drive:][path]\r\n";
 1297, "CD[..]\r\n";
 1298, "CD -\r\n";
 1299, "\r\n";
 1300, "  ..   Specifies that you want to change to the parent directory.\r\n";
 1301, "  -    If \"last directory\" feature is enabled, change to last directory.\r\n";
 1302, "\r\n";
 1303, "Type CD drive: to display the current directory in the specified drive.\r\n";
 1304, "Type CD without parameters to display the current drive and directory.\r\n";
 1305, "See also: CDD\r\n";
 1306, "Displays the name of or changes the current directory and drive.\r\n";
 1307, "\r\n";
 1308, "CDD [drive:][path]\r\n";
 1309, "CDD[..]\r\n";
 1310, "\r\n";
 1311, "  ..   Specifies that you want to change to the parent directory.\r\n";
 1312, "  -    If \"last directory\" feature is enabled, change to last directory.\r\n";
 1313, "\r\n";
 1314, "If drive: is specified, the current working drive is changed; this\r\n";
 1315, "is the only different to \"CHDIR\".\r\n";
 1316, "Type CD without parameters to display the current drive and directory.\r\n";
 1317, "Displays or sets the active code page number.\r\n";
 1318, "\r\n";
 1319, "CHCP [nnn]\r\n";
 1320, "\r\n";
 1321, "  nnn   Specifies a code page number.\r\n";
 1322, "\r\n";
 1323, "Type CHCP without a parameter to display the active code page number.\r\n";
 1324, "Clears the screen.\r\n";
 1325, "\r\n";
 1326, "CLS\r\n";
 1327, "Starts a new copy of the FreeDOS command shell.\r\n";
 1328, "\r\n";
 1329, "COMMAND [[drive:]path] [device] [/E:nnnnn] [/L:nnnn] [/U:nnn] [/P] [/MSG]\r\n";
 1330, "                       [/LOW] [/Y [/[C|K] command]]\r\n";
 1331, "  [drive:]path    Specifies the directory containing COMMAND.COM.\r\n";
 1332, "  device          Specifies the device to use for command input and output.\r\n";
 1333, "  /E:nnnnn        Sets the initial environment size to nnnnn bytes.\r\n";
 1334, "                  (nnnnn should be between 256 and 32,768).\r\n";
 1335, "  /L:nnnn         Specifies internal buffers length (requires /P as well).\r\n";
 1336, "                  (nnnn should be between 128 and 1,024).\r\n";
 1337, "  /U:nnn          Specifies the input buffer length (requires /P as well).\r\n";
 1338, "                  (nnn should be between 128 and 255).\r\n";
 1339, "  /P              Makes the new command shell permanent (can't exit).\r\n";
 1340, "  /MSG            Stores all error messages in memory (requires /P as well).\r\n";
 1341, "  /LOW            Forces the command shell to keep its resident data in\r\n";
 1342, "                  low memory.\r\n";
 1343, "  /Y              Steps through the batch program specified by /C or /K.\r\n";
 1344, "  /C command      Executes the specified command and returns.\r\n";
 1345, "  /K command      Executes the specified command and continues running.\r\n";
 1346, "Copies one or more files to another location.\r\n";
 1347, "\r\n";
 1348, "COPY [/A | /B] source [/A | /B] [+ source [/A | /B] [+ ...]] [destination\r\n";
 1349, "  [/A | /B]] [/V] [/Y | /-Y]\r\n";
 1350, "\r\n";
 1351, "  source       Specifies the file or files to be copied.\r\n";
 1352, "  /A           Indicates an ASCII text file.\r\n";
 1353, "  /B           Indicates a binary file.\r\n";
 1354, "  destination  Specifies the directory and/or filename for the new file(s).\r\n";
 1355, "  /V           Verifies that new files are written correctly.\r\n";
 1356, "  /Y           Suppresses prompting to confirm you want to overwrite an\r\n";
 1357, "               existing destination file.\r\n";
 1358, "  /-Y          Causes prompting to confirm you want to overwrite an\r\n";
 1359, "               existing destination file.\r\n";
 1360, "\r\n";
 1361, "The switch /Y may be preset in the COPYCMD environment variable.\r\n";
 1362, "This may be overridden with /-Y on the command line.\r\n";
 1363, "\r\n";
 1364, "To append files, specify a single file for destination, but multiple files\r\n";
 1365, "for source (using wildcards or file1+file2+file3 format).\r\n";
 1366, "Changes the terminal device used to control your system.\r\n";
 1367, "\r\n";
 1368, "CTTY device\r\n";
 1369, "\r\n";
 1370, "  device   The terminal device you want to use, such as COM1.\r\n";
 1371, "Displays or sets the date.\r\n";
 1372, "\r\n";
 1373, "DATE [/D] [date]\r\n";
 1374, "\r\n";
 1375, "Type DATE without parameters to display the current date setting and a\r\n";
 1376, "prompt for a new one.  Press ENTER to keep the same date.\r\n";
 1377, "\r\n";
 1378, "/D prevents DATE to become interactive.\r\n";
 1379, "Deletes one or more files.\r\n";
 1380, "\r\n";
 1381, "DEL [drive:][path]filename [/P] [/V]\r\n";
 1382, "ERASE [drive:][path]filename [/P] [/V]\r\n";
 1383, "\r\n";
 1384, "  [drive:][path]filename  Specifies the file(s) to delete.  Specify multiple\r\n";
 1385, "                          files by using wildcards.\r\n";
 1386, "  /P	Prompts for confirmation before deleting each file.\r\n";
 1387, "  /V	Displays all deleted files.\r\n";
 1388, "Displays a list of files and subdirectories in a directory.\r\n";
 1389, "\r\n";
 1390, "DIR [drive:][path][filename] [/P] [/W] [/A[[:]attributes]]\r\n";
 1391, "  [/O[[:]sortorder]] [/S] [/B] [/L] [/V]\r\n";
 1392, "\r\n";
 1393, "  [drive:][path][filename]\r\n";
 1394, "            Specifies drive, directory, and/or files to list.\r\n";
 1395, "            (Could be enhanced file specification or multiple filespecs.)\r\n";
 1396, " /P         Pauses after each screenful of information.\r\n";
 1397, " /W         Uses wide list format.\r\n";
 1398, " /A         Displays files with specified attributes. (Defaults to /ADHSRA)\r\n";
 1399, " attributes  D  Directories                R  Read-only files\r\n";
 1400, "             H  Hidden files               A  Files ready for archiving\r\n";
 1401, "             S  System files               -  Prefix meaning not\r\n";
 1402, " /O         List by files in sorted order.\r\n";
 1403, " sortorder   N  By name (alphabetic)       S  By size (smallest first)\r\n";
 1404, "             E  By extension (alphabetic)  D  By date & time (earliest first)\r\n";
 1405, "             G  Group directories first    -  Prefix to reverse order\r\n";
 1406, "             U  Unsorted		   Defaults to /ONG\r\n";
 1407, " /S         Displays files in specified directory and all subdirectories.\r\n";
 1408, " /B         Uses bare format (no heading information or summary).\r\n";
 1409, " /L         Uses lowercase.\r\n";
 1410, " /Y or /4   Display 4-digit year.\r\n";
 1411, "\r\n";
 1412, "Switches may be preset in the DIRCMD environment variable.  Override\r\n";
 1413, "preset switches by prefixing any switch with - (hyphen)--for example, /-W.\r\n";
 1414, "The external DOSKEY utility had been incorporated into FreeCOM.\r\n";
 1415, "Use cursor UP,& DOWN keys to recall the history and HISTORY to display it.\r\n";
 1416, "Use cursor LEFT,& RIGHT and the END and HOME keys to navigate within\r\n";
 1417, "the command line and toggle INSERT between overstrike and insert mode.\r\n";
 1418, "Use the TAB key to complete the current word as filename; use it twice\r\n";
 1419, "to show all matching files.\r\n";
 1420, "Edits command lines, recalls command lines, and creates macros\r\n";
 1421, "\r\n";
 1422, "DOSKEY [/switch ...] [macroname=[text]]\r\n";
 1423, "\r\n";
 1424, "  /BUFSIZE:size Sets size of macro and command buffer            (default:512)\r\n";
 1425, "  /ECHO:on|off  Enables/disables echo of macro expansions        (default:on)\r\n";
 1426, "  /FILE:file    Specifies file containing a list of macros\r\n";
 1427, "  /HISTORY      Displays all commands stored in memory\r\n";
 1428, "  /INSERT       Inserts new characters into line when typing\r\n";
 1429, "  /KEYSIZE:size Sets size of keyboard type-ahead buffer          (default:15)\r\n";
 1430, "  /LINE:size    Sets maximum size of line edit buffer            (default:128)\r\n";
 1431, "  /MACROS       Displays all DOSKey macros\r\n";
 1432, "  /OVERSTRIKE   Overwrites new characters onto line when typing  (default)\r\n";
 1433, "  /REINSTALL    Installs a new copy of DOSKey\r\n";
 1434, "  macroname     Specifies a name for a macro you create\r\n";
 1435, "  text          Specifies commands you want to assign to the macro\r\n";
 1436, "\r\n";
 1437, "  UP,DOWN arrows recall commands\r\n";
 1438, "      Esc clears current command\r\n";
 1439, "       F7 displays command history\r\n";
 1440, "   Alt+F7 clears command history\r\n";
 1441, "[chars]F8 searches for command beginning with [chars]\r\n";
 1442, "       F9 selects a command by number\r\n";
 1443, "  Alt+F10 clears macro definitions\r\n";
 1444, "\r\n";
 1445, "The following are special codes you can use in DOSKey macro definitions:\r\n";
 1446, "  $T     Command separator: allows multiple commands in a macro\r\n";
 1447, "  $1-$9  Batch parameters: equivalent to %1-%9 in batch programs\r\n";
 1448, "  $*     Symbol replaced by everything following macro name on the command line\r\n";
 1449, "Displays messages, or turns command-echoing on or off.\r\n";
 1450, "\r\n";
 1451, "  ECHO [ON | OFF]\r\n";
 1452, "  ECHO [message]\r\n";
 1453, "\r\n";
 1454, "Type ECHO without parameters to display the current echo setting.\r\n";
 1455, "Quits the FreeDOS command shell unless loaded with /P.\r\n";
 1456, "\r\n";
 1457, "EXIT\r\n";
 1458, "Runs a specified command for each file in a set of files.\r\n";
 1459, "\r\n";
 1460, "FOR %variable IN (set) DO command [command-parameters]\r\n";
 1461, "\r\n";
 1462, "  %variable  Specifies a replaceable parameter.\r\n";
 1463, "  (set)      Specifies a set of one or more files.  Wildcards may be used.\r\n";
 1464, "  command    Specifies the command to carry out for each file.\r\n";
 1465, "  command-parameters\r\n";
 1466, "             Specifies parameters or switches for the specified command.\r\n";
 1467, "\r\n";
 1468, "To use the FOR command in a batch program, specify %%variable instead of\r\n";
 1469, "%variable.\r\n";
 1470, "\r\n";
 1471, "For example:\r\n";
 1472, "  FOR %f IN (---start--- a*.* ---end---) DO ECHO - %f -\r\n";
 1473, "Directs the command shell to a labelled line in a batch program.\r\n";
 1474, "\r\n";
 1475, "GOTO label\r\n";
 1476, "\r\n";
 1477, "  label   Specifies a text string used in the batch program as a label.\r\n";
 1478, "\r\n";
 1479, "You type a label on a line by itself, beginning with a colon.\r\n";
 1480, "History command.\r\n";
 1481, "\r\n";
 1482, "HISTORY [size]\r\n";
 1483, "\r\n";
 1484, "Without \"size\" the current contents of the command line history\r\n";
 1485, "buffer is displayed.\r\n";
 1486, "With the size, the size of the history buffer is changed.\r\n";
 1487, "Performs conditional processing in batch programs.\r\n";
 1488, "\r\n";
 1489, "IF [NOT] ERRORLEVEL number command\r\n";
 1490, "IF [NOT] string1==string2 command\r\n";
 1491, "IF [NOT] EXIST filename command\r\n";
 1492, "\r\n";
 1493, "  NOT               Specifies that the command shell should carry out the\r\n";
 1494, "                    command only if the condition is false.\r\n";
 1495, "  ERRORLEVEL number Specifies a true condition if the last program run\r\n";
 1496, "                    returned an exit code equal to or greater than the\r\n";
 1497, "                    number specified.\r\n";
 1498, "  command           Specifies the command to carry out if the condition is\r\n";
 1499, "                    met.\r\n";
 1500, "  string1==string2  Specifies a true condition if the specified text\r\n";
 1501, "                    strings match.\r\n";
 1502, "  EXIST filename    Specifies a true condition if the specified filename\r\n";
 1503, "                    exists.\r\n";
 1504, "Loads a program into the upper memory area.\r\n";
 1505, "\r\n";
 1506, "LOADHIGH [drive:][path]filename [parameters]\r\n";
 1507, "LOADHIGH [/L:region1[,minsize1][;region2[,minsize2]...] [/S]]\r\n";
 1508, "         [drive:][path]filename [parameters]\r\n";
 1509, "\r\n";
 1510, "/L:region1[,minsize1][;region2[,minsize2]]...\r\n";
 1511, "            Specifies the region(s) of memory into which to load the\r\n";
 1512, "            program.  Region1 specifies the number of the first memory\r\n";
 1513, "            region; minsize1 specifies the minimum size, if any, for\r\n";
 1514, "            region1.  Region2 and minsize2 specify the number and minimum\r\n";
 1515, "            size of the second region, if any.  You can specify as many\r\n";
 1516, "            regions as you want.\r\n";
 1517, "\r\n";
 1518, "/S          Shrinks a UMB to its minimum size while the program is\r\n";
 1519, "            loading.\r\n";
 1520, "\r\n";
 1521, "[drive:][path]filename\r\n";
 1522, "            Specifies the location and name of the program.\r\n";
 1523, "Loads a program above the first 64K of memory, and runs the program.\r\n";
 1524, "\r\n";
 1525, "LOADFIX [drive:][path]filename\r\n";
 1526, "\r\n";
 1527, "Use LOADFIX to load a program if you have received the message \"Packed\r\n";
 1528, "file corrupt\" when trying to load it in low memory.\r\n";
 1529, "Creates a directory.\r\n";
 1530, "\r\n";
 1531, "MKDIR [drive:]path\r\n";
 1532, "MD [drive:]path\r\n";
 1533, "Displays or sets a search path for executable files.\r\n";
 1534, "\r\n";
 1535, "PATH [[drive:]path[;...]]\r\n";
 1536, "PATH ;\r\n";
 1537, "\r\n";
 1538, "Type PATH ; to clear all search-path settings and direct the command shell\r\n";
 1539, "to search only in the current directory.\r\n";
 1540, "Type PATH without parameters to display the current path.\r\n";
 1541, "Suspends processing of a batch program and displays the message:\r\n";
 1542, "\"Press any key to continue....\" or an optional specified message.\r\n";
 1543, "\r\n";
 1544, "PAUSE [message]\r\n";
 1545, "Suspends processing for a specified time.\r\n";
 1546, "\r\n";
 1547, "WAIT milliseconds\r\n";
 1548, "Changes the command prompt.\r\n";
 1549, "\r\n";
 1550, "PROMPT [text]\r\n";
 1551, "\r\n";
 1552, "  text    Specifies a new command prompt.\r\n";
 1553, "\r\n";
 1554, "Prompt can be made up of normal characters and the following special\r\n";
 1555, "codes:\r\n";
 1556, "\r\n";
 1557, "  $Q   = (equal sign)\r\n";
 1558, "  $$   $ (dollar sign)\r\n";
 1559, "  $T   Current time\r\n";
 1560, "  $D   Current date\r\n";
 1561, "  $P   Current drive and path\r\n";
 1562, "  $V   the FreeDOS command shell version number\r\n";
 1563, "  $N   Current drive\r\n";
 1564, "  $G   > (greater-than sign)\r\n";
 1565, "  $L   < (less-than sign)\r\n";
 1566, "  $B   | (pipe)\r\n";
 1567, "  $H   Backspace (erases previous character)\r\n";
 1568, "  $E   Escape code (ASCII code 27)\r\n";
 1569, "  $_   Carriage return and linefeed\r\n";
 1570, "\r\n";
 1571, "Type PROMPT without parameters to reset the prompt to the default setting.\r\n";
 1572, "Pushes current directory onto the directory stack, with the option to\r\n";
 1573, "change current working directory.\r\n";
 1574, "\r\n";
 1575, "PUSHD [[drive:]path]\r\n";
 1576, "  Where [drive:]path is a path to which you wish to change.\r\n";
 1577, "Pops a directory off of the directory stack, and changes to it.\r\n";
 1578, "\r\n";
 1579, "POPD [*]\r\n";
 1580, "  The '*' parameter clears the directory stack.\r\n";
 1581, "Displays the contents of the directory stack.\r\n";
 1582, "\r\n";
 1583, "DIRS\r\n";
 1584, "Removes (deletes) a directory.\r\n";
 1585, "\r\n";
 1586, "RMDIR [drive:]path\r\n";
 1587, "RD [drive:]path\r\n";
 1588, "Records comments (remarks) in a batch file or CONFIG.SYS.\r\n";
 1589, "\r\n";
 1590, "REM [comment]\r\n";
 1591, "Renames a file/directory or files/directories.\r\n";
 1592, "\r\n";
 1593, "RENAME [drive:][path][directoryname1 | filename1] [directoryname2 | filename2]\r\n";
 1594, "REN [drive:][path][directoryname1 | filename1] [directoryname2 | filename2]\r\n";
 1595, "\r\n";
 1596, "Note that you cannot specify a new drive or path for your destination. Use\r\n";
 1597, "the MOVE command for that purpose.\r\n";
 1598, "Displays, sets, or removes environment variables.\r\n";
 1599, "\r\n";
 1600, "SET [/C] [/P] [variable=[string]]\r\n";
 1601, "\r\n";
 1602, "  variable  Specifies the environment-variable name.\r\n";
 1603, "  string    Specifies a series of characters to assign to the variable.\r\n";
 1604, "\r\n";
 1605, "* If no string is specified, the variable is removed from the environment.\r\n";
 1606, "\r\n";
 1607, "Type SET without parameters to display the current environment variables.\r\n";
 1608, "\r\n";
 1609, "/C forces to keep the case of the variable; by default the variable is\r\n";
 1610, "uppercased, if it is not located in the environment already, otherwise\r\n";
 1611, "the case is retained.\r\n";
 1612, "\r\n";
 1613, "/P prompt the user with string, and assigns the user input to the variable.\r\n";
 1614, "Changes the position of replaceable parameters in a batch file.\r\n";
 1615, "\r\n";
 1616, "SHIFT [DOWN]\r\n";
 1617, "\r\n";
 1618, "DOWN shifts the argument window toward the beginning (%0); otherwise\r\n";
 1619, "toward the end.\r\n";
 1620, "Displays or sets the system time.\r\n";
 1621, "\r\n";
 1622, "TIME [/T] [time]\r\n";
 1623, "\r\n";
 1624, "Type TIME with no parameters to display the current time setting and a\r\n";
 1625, "prompt for a new one.  Press ENTER to keep the same time.\r\n";
 1626, "\r\n";
 1627, "/T prevents TIME from becoming interactive.\r\n";
 1628, "Displays the full path name of the path specified.\r\n";
 1629, "\r\n";
 1630, "TRUENAME [drive:][path][filename]\r\n";
 1631, "Displays the contents of text files.\r\n";
 1632, "\r\n";
 1633, "TYPE [drive:][path]filename\r\n";
 1634, "Displays the FreeDOS command shell version and other information.\r\n";
 1635, "\r\n";
 1636, "VER [/R] [/W] [/D] [/C]\r\n";
 1637, "\r\n";
 1638, " /R         Shows kernel version and other information.\r\n";
 1639, " /W         FreeDOS command shell warranty.\r\n";
 1640, " /D         FreeDOS command shell redistribution information.\r\n";
 1641, " /C         FreeDOS command shell contributors.\r\n";
 1642, "Tells the FreeDOS file system whether to verify that your files are\r\n";
 1643, "written correctly to a disk.\r\n";
 1644, "\r\n";
 1645, "VERIFY [ON | OFF]\r\n";
 1646, "\r\n";
 1647, "Type VERIFY without a parameter to display the current VERIFY setting.\r\n";
 1648, "If debugging is compiled into FreeDOS, this command will turn debug\r\n";
 1649, "output on or off, or tell you if it is on or off.\r\n";
 1650, "\r\n";
 1651, "FDDEBUG [ON | OFF | file]\r\n";
 1652, "\r\n";
 1653, "Type FDDEBUG without a parameter to display the current debug output\r\n";
 1654, "setting.\r\n";
 1655, "If a file is specified, all debug output is redirected into that file;\r\n";
 1656, "the output is appended to the file, if it already exists. The special\r\n";
 1657, "names \"stdout\" and \"stderr\" may be used to redirect the output\r\n";
 1658, "to the standard output or standard error stream.\r\n";
 1659, "Displays the disk volume label and serial number, if they exist.\r\n";
 1660, "\r\n";
 1661, "VOL [drive:]\r\n";
 1662, "Displays a list of commands and features available with in the shell.\r\n";
 1663, "\r\n";
 1664, "?\r\n";
 1665, "?command [argument]\r\n";
 1666, "\r\n";
 1667, "The first variant displays any available internal command and feature.\r\n";
 1668, "The second one will prompt whether or not to execute the specified\r\n";
 1669, "command as if trace mode would be active.\r\n";
 1670, "Searches and displays the executable file for each specified command.\r\n";
 1671, "\r\n";
 1672, "WHICH command...\r\n";
 1673, "Displays the internal memory used by FreeCOM internally.\r\n";
 1674, "\r\n";
 1675, "MEMORY\r\n";
 1676, "\r\n";
 1677, "The COPY destination must not contain plus ('+') characters.\r\n";
 1678, "Deleting file \"%s\".\r\n";
 1679, "Unable to write to file '%s';\r\n";
 1680, "probably disc full? (%lu bytes required)\r\n";
 1681, "copied %luKB/???KB\r\n";
 1682, "copied %luKB/%luKB\r\n";
 1683, "FreeCOM cannot be a device: \"%s\"\r\n";
 1684, "This file is no valid FreeCOM or of an incompatible version:\r\n";
 1685, "%s\r\n";
 1686, "Failed to load the strings resource into memory, the location\r\n";
 1687, "pointed to in %COMSPEC% seems to be invalid. Please specify another\r\n";
 1688, "location of FreeCOM to try to load the strings from, e.g.:\r\n";
 1689, "C:\\COMMAND.COM\r\n";
 1690, "or just hit enter to cancel to load the strings.\r\n";
 1691, "Show harddrive partition information\r\n";
 1692, "\r\n";
 1693, "PART [/D] [disc]\r\n";
 1694, "  [disc]          Show partitions on a specified disc\r\n";
 1695, "  /D              Shows detailed information about partition tables\r\n";
 1696, "Disc %d not found\r\n";
 1697, "Disc %d %08lX BIOS sectors / cyl %04X, heads %04X\r\n";
 1698, "Disc %d\r\n";
 1699, "\r\n";
 1700, "  DRV TYPE    SECTORS       FILESYS         TOTAL SIZE          FREE SIZE\r\n";
 1701, "%d: -- No entry\r\n";
 1702, "Remove harddrive partition\r\n";
 1703, "\r\n";
 1704, "RMPART [/Y] disc part\r\n";
 1705, "  disc            Disc number\r\n";
 1706, "  part            Partition number\r\n";
 1707, "  /Y              Don't ask before removing partition\r\n";
 1708, "Partition %d not found or invalid\r\n";
 1709, "Removing drive %s\r\n";
 1710, "Size: %s\r\n";
 1711, "Removing partition %d on disc %d\r\n";
 1712, "Size: %s\r\n";
 1713, "YyNn\rDelete (Yes/No) ? ";
 1714, "Make harddrive partition\r\n";
 1715, "\r\n";
 1716, "MKPART disc filesys size\r\n";
 1717, "  disc            Disc number\r\n";
 1718, "  filesys         Filesystem name\r\n";
 1719, "  size            Partition size in MB\r\n";
 1720, "\r\n";
 1721, "Currently supported filesystem names are:\r\n";
 1722, "FAT12, FAT16, FAT32, RDFS and FLASHFS\r\n";
 1723, "Unable to create partition. Invalid size of filesystem name\r\n";
 1724, "Init harddrive partition table and write RDOS bootloader\r\n";
 1725, "\r\n";
 1726, "INITHD /R disc\r\n";
 1727, "  disc            Disc number\r\n";
 1728, "  /R              Make RDOS normal boot as default\r\n";
 1729, "Not enough free sectors at the begining of disc %d\r\n";
 1730, "Ping a node\r\n";
 1731, "\r\n";
 1732, "PING [ip-address] [host name]\r\n";
 1733, "  ip-address      IP address to ping\r\n";
 1734, "  host name       Host name to ping\r\n";
 1735, "Invalid IP address\r\n";
 1736, "Cannot find host name\r\n";
 1737, "Pinging node %d.%d.%d.%d\r\n";
 1738, "Ping ok\r\n";
 1739, "Ping timeout\r\n";
 1740, "Init floppy and write RDOS bootloader\r\n";
 1741, "\r\n";
 1742, "INITFD \r\n";
 1743, "List running threads\r\n";
 1744, "\r\n";
 1745, "STATE [/S] [thread-ID]\r\n";
 1746, "  /S              Suspend thread\r\n";
 1747, "Moves one or more files to another location.\r\n";
 1748, "\r\n";
 1749, "MOVE source [source [ ...]] [destination]\r\n";
 1750, "\r\n";
 1751, "  source       Specifies the file or files to be moved.\r\n";
 1752, "  destination  Specifies the directory and/or filename for the new file(s).\r\n";
 1753, "MOVE failed\r\n";
 1754, "Destination file (%s) already exists.\r\n";
 1755, "Cannot move multiple files to a single destination.\r\n";
 1756, "'%s' kan inte ha n†gra parametrar\r\n";
