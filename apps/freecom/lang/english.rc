 472, "\r";
 473, "The FreeDOS Command Shell developed by many developers, please refer\r";
 474, "to the enclose HISTORY.TXT file.\r";
 475, "\r";
 476, "Currently maintained by Steffen Kaiser mailto:freecomfreedos.org\r";
 477, "\r";
 478, "Send bug reports to fd-freecomtopica.com.\r";
 479, "Updates are available from http://freedos.sourceforge.net/freecom\r";
 480, "\r";
 481, "\r";
 482, "\r";
 483, "\r";
 484, "The shell is about to be terminated, though, this is\r";
 485, "\r";
 486, "forbidden (usually by enabling the \"/P\" option).\r";
 487, "\r";
 488, "You must reboot the system or, if this shell runs in\r";
 489, "\r";
 490, "a multitasking environment, terminate this process/task manually.\r";
 491, "\r";
 492, "FreeCOM executable not found.\r";
 493, "You must specify the complete path to COMMAND.COM\r";
 494, "as the first argument of COMMAND, for instance:\r";
 495, "C:\\FDOS\r";
 496, "Environment segment    : max %5u bytes; free %5u bytes\r";
 497, "Context segment        : max %5u bytes; free %5u bytes\r";
 498, "Heap                   : free %5lu bytes\r";
 499, "	Aliases        : limit %5u bytes, current %5u bytes, %5u items\r";
 500, "	History        : limit %5u bytes, current %5u bytes, %5u items\r";
 501, "	Directory stack: limit %5u bytes, current %5u bytes, %5u items\r";
 502, "	Last dir cache : used  %5u bytes, %5u items\r";
 503, "	Batch nesting  : used  %5u bytes, %5u items\r";
 504, "	Swapinfo       : used  %5u bytes, %5u items\r";
 505, "Failed to aquire current code page from system.\r";
 506, "Failed to change current code page.\r";
 507, "The current codepage is %u.\r";
 508, "The system codepage (properly) is: %u.\r";
 509, "Displays, sets, or removes aliases.\r";
 510, "\r";
 511, "ALIAS [variable[=][string]]\r";
 512, "\r";
 513, "	variable  Specifies the alias name.\r";
 514, "	string    Specifies a series of characters to assign to the alias.\r";
 515, "\r";
 516, "\r";
 517, "Type ALIAS without parameters to display the current aliases.\r";
 518, "Make a beep sound.\r";
 519, "Sets or clears extended CTRL+C checking.\r";
 520, "\r";
 521, "BREAK [ON | OFF]\r";
 522, "\r";
 523, "Type BREAK without a parameter to display the current BREAK setting.\r";
 524, "Calls one batch program from another.\r";
 525, "\r";
 526, "CALL [/S | /N] [/Y] [drive:][path]filename [batch-parameters]\r";
 527, "\r";
 528, "  batch-parameters   Specifies any command-line information required by\r";
 529, "                     the batch program.\r";
 530, "  /S enforces, /N denies swapping of FreeCOM.\r";
 531, "  /Y enables tracemode during execution of the command.\r";
 532, "Displays the name of or changes the current directory.\r";
 533, "\r";
 534, "CHDIR [drive:][path]\r";
 535, "CHDIR[..]\r";
 536, "CD [drive:][path]\r";
 537, "CD[..]\r";
 538, "CD -\r";
 539, "\r";
 540, "  ..   Specifies that you want to change to the parent directory.\r";
 541, "  -    If \"last directory\" feature is enabled, change to last directory.\r";
 542, "\r";
 543, "Type CD drive: to display the current directory in the specified drive.\r";
 544, "Type CD without parameters to display the current drive and directory.\r";
 545, "See also: CDD\r";
 546, "Displays the name of or changes the current directory and drive.\r";
 547, "\r";
 548, "CDD [drive:][path]\r";
 549, "CDD[..]\r";
 550, "\r";
 551, "  ..   Specifies that you want to change to the parent directory.\r";
 552, "  -    If \"last directory\" feature is enabled, change to last directory.\r";
 553, "\r";
 554, "If drive: is specified, the current working drive is changed; this\r";
 555, "is the only different to \"CHDIR\".\r";
 556, "Type CD without parameters to display the current drive and directory.\r";
 557, "Displays or sets the active code page number.\r";
 558, "\r";
 559, "CHCP [nnn]\r";
 560, "\r";
 561, "  nnn   Specifies a code page number.\r";
 562, "\r";
 563, "Type CHCP without a parameter to display the active code page number.\r";
 564, "Clears the screen.\r";
 565, "\r";
 566, "CLS\r";
 567, "Starts a new copy of the FreeDOS command shell.\r";
 568, "\r";
 569, "COMMAND [[drive:]path] [device] [/E:nnnnn] [/L:nnnn] [/U:nnn] [/P] [/MSG]\r";
 570, "                       [/LOW] [/Y [/[C|K] command]]\r";
 571, "  [drive:]path    Specifies the directory containing COMMAND.COM.\r";
 572, "  device          Specifies the device to use for command input and output.\r";
 573, "  /E:nnnnn        Sets the initial environment size to nnnnn bytes.\r";
 574, "                  (nnnnn should be between 256 and 32,768).\r";
 575, "  /L:nnnn         Specifies internal buffers length (requires /P as well).\r";
 576, "                  (nnnn should be between 128 and 1,024).\r";
 577, "  /U:nnn          Specifies the input buffer length (requires /P as well).\r";
 578, "                  (nnn should be between 128 and 255).\r";
 579, "  /P              Makes the new command shell permanent (can't exit).\r";
 580, "  /MSG            Stores all error messages in memory (requires /P as well).\r";
 581, "  /LOW            Forces the command shell to keep its resident data in\r";
 582, "                  low memory.\r";
 583, "  /Y              Steps through the batch program specified by /C or /K.\r";
 584, "  /C command      Executes the specified command and returns.\r";
 585, "  /K command      Executes the specified command and continues running.\r";
 586, "Copies one or more files to another location.\r";
 587, "\r";
 588, "COPY [/A | /B] source [/A | /B] [+ source [/A | /B] [+ ...]] [destination\r";
 589, "  [/A | /B]] [/V] [/Y | /-Y]\r";
 590, "\r";
 591, "  source       Specifies the file or files to be copied.\r";
 592, "  /A           Indicates an ASCII text file.\r";
 593, "  /B           Indicates a binary file.\r";
 594, "  destination  Specifies the directory and/or filename for the new file(s).\r";
 595, "  /V           Verifies that new files are written correctly.\r";
 596, "  /Y           Suppresses prompting to confirm you want to overwrite an\r";
 597, "               existing destination file.\r";
 598, "  /-Y          Causes prompting to confirm you want to overwrite an\r";
 599, "               existing destination file.\r";
 600, "\r";
 601, "The switch /Y may be preset in the COPYCMD environment variable.\r";
 602, "This may be overridden with /-Y on the command line.\r";
 603, "\r";
 604, "To append files, specify a single file for destination, but multiple files\r";
 605, "for source (using wildcards or file1+file2+file3 format).\r";
 606, "Changes the terminal device used to control your system.\r";
 607, "\r";
 608, "CTTY device\r";
 609, "\r";
 610, "  device   The terminal device you want to use, such as COM1.\r";
 611, "Displays or sets the date.\r";
 612, "\r";
 613, "DATE [/D] [date]\r";
 614, "\r";
 615, "Type DATE without parameters to display the current date setting and a\r";
 616, "prompt for a new one.  Press ENTER to keep the same date.\r";
 617, "\r";
 618, "/D prevents DATE to become interactive.\r";
 619, "Deletes one or more files.\r";
 620, "\r";
 621, "DEL [drive:][path]filename [/P] [/V]\r";
 622, "ERASE [drive:][path]filename [/P] [/V]\r";
 623, "\r";
 624, "  [drive:][path]filename  Specifies the file(s) to delete.  Specify multiple\r";
 625, "                          files by using wildcards.\r";
 626, "  /P	Prompts for confirmation before deleting each file.\r";
 627, "  /V	Displays all deleted files.\r";
 628, "Displays a list of files and subdirectories in a directory.\r";
 629, "\r";
 630, "DIR [drive:][path][filename] [/P] [/W] [/A[[:]attributes]]\r";
 631, "  [/O[[:]sortorder]] [/S] [/B] [/L] [/V]\r";
 632, "\r";
 633, "  [drive:][path][filename]\r";
 634, "            Specifies drive, directory, and/or files to list.\r";
 635, "            (Could be enhanced file specification or multiple filespecs.)\r";
 636, " /P         Pauses after each screenful of information.\r";
 637, " /W         Uses wide list format.\r";
 638, " /A         Displays files with specified attributes. (Defaults to /ADHSRA)\r";
 639, " attributes  D  Directories                R  Read-only files\r";
 640, "             H  Hidden files               A  Files ready for archiving\r";
 641, "             S  System files               -  Prefix meaning not\r";
 642, " /O         List by files in sorted order.\r";
 643, " sortorder   N  By name (alphabetic)       S  By size (smallest first)\r";
 644, "             E  By extension (alphabetic)  D  By date & time (earliest first)\r";
 645, "             G  Group directories first    -  Prefix to reverse order\r";
 646, "             U  Unsorted		   Defaults to /ONG\r";
 647, " /S         Displays files in specified directory and all subdirectories.\r";
 648, " /B         Uses bare format (no heading information or summary).\r";
 649, " /L         Uses lowercase.\r";
 650, " /Y or /4   Display 4-digit year.\r";
 651, "\r";
 652, "Switches may be preset in the DIRCMD environment variable.  Override\r";
 653, "preset switches by prefixing any switch with - (hyphen)--for example, /-W.\r";
 654, "The external DOSKEY utility had been incorporated into FreeCOM.\r";
 655, "Use cursor UP,& DOWN keys to recall the history and HISTORY to display it.\r";
 656, "Use cursor LEFT,& RIGHT and the END and HOME keys to navigate within\r";
 657, "the command line and toggle INSERT between overstrike and insert mode.\r";
 658, "Use the TAB key to complete the current word as filename; use it twice\r";
 659, "to show all matching files.\r";
 660, "Edits command lines, recalls command lines, and creates macros\r";
 661, "\r";
 662, "DOSKEY [/switch ...] [macroname=[text]]\r";
 663, "\r";
 664, "  /BUFSIZE:size Sets size of macro and command buffer            (default:512)\r";
 665, "  /ECHO:on|off  Enables/disables echo of macro expansions        (default:on)\r";
 666, "  /FILE:file    Specifies file containing a list of macros\r";
 667, "  /HISTORY      Displays all commands stored in memory\r";
 668, "  /INSERT       Inserts new characters into line when typing\r";
 669, "  /KEYSIZE:size Sets size of keyboard type-ahead buffer          (default:15)\r";
 670, "  /LINE:size    Sets maximum size of line edit buffer            (default:128)\r";
 671, "  /MACROS       Displays all DOSKey macros\r";
 672, "  /OVERSTRIKE   Overwrites new characters onto line when typing  (default)\r";
 673, "  /REINSTALL    Installs a new copy of DOSKey\r";
 674, "  macroname     Specifies a name for a macro you create\r";
 675, "  text          Specifies commands you want to assign to the macro\r";
 676, "\r";
 677, "  UP,DOWN arrows recall commands\r";
 678, "      Esc clears current command\r";
 679, "       F7 displays command history\r";
 680, "   Alt+F7 clears command history\r";
 681, "[chars]F8 searches for command beginning with [chars]\r";
 682, "       F9 selects a command by number\r";
 683, "  Alt+F10 clears macro definitions\r";
 684, "\r";
 685, "The following are special codes you can use in DOSKey macro definitions:\r";
 686, "  $T     Command separator: allows multiple commands in a macro\r";
 687, "  $1-$9  Batch parameters: equivalent to %1-%9 in batch programs\r";
 688, "  $*     Symbol replaced by everything following macro name on the command line\r";
 689, "Displays messages, or turns command-echoing on or off.\r";
 690, "\r";
 691, "  ECHO [ON | OFF]\r";
 692, "  ECHO [message]\r";
 693, "\r";
 694, "Type ECHO without parameters to display the current echo setting.\r";
 695, "Quits the FreeDOS command shell unless loaded with /P.\r";
 696, "\r";
 697, "EXIT\r";
 698, "Runs a specified command for each file in a set of files.\r";
 699, "\r";
 700, "FOR %variable IN (set) DO command [command-parameters]\r";
 701, "\r";
 702, "  %variable  Specifies a replaceable parameter.\r";
 703, "  (set)      Specifies a set of one or more files.  Wildcards may be used.\r";
 704, "  command    Specifies the command to carry out for each file.\r";
 705, "  command-parameters\r";
 706, "             Specifies parameters or switches for the specified command.\r";
 707, "\r";
 708, "To use the FOR command in a batch program, specify %%variable instead of\r";
 709, "%variable.\r";
 710, "\r";
 711, "For example:\r";
 712, "  FOR %f IN (---start--- a*.* ---end---) DO ECHO - %f -\r";
 713, "Directs the command shell to a labelled line in a batch program.\r";
 714, "\r";
 715, "GOTO label\r";
 716, "\r";
 717, "  label   Specifies a text string used in the batch program as a label.\r";
 718, "\r";
 719, "You type a label on a line by itself, beginning with a colon.\r";
 720, "History command.\r";
 721, "\r";
 722, "HISTORY [size]\r";
 723, "\r";
 724, "Without \"size\" the current contents of the command line history\r";
 725, "buffer is displayed.\r";
 726, "With the size, the size of the history buffer is changed.\r";
 727, "Performs conditional processing in batch programs.\r";
 728, "\r";
 729, "IF [NOT] ERRORLEVEL number command\r";
 730, "IF [NOT] string1==string2 command\r";
 731, "IF [NOT] EXIST filename command\r";
 732, "\r";
 733, "  NOT               Specifies that the command shell should carry out the\r";
 734, "                    command only if the condition is false.\r";
 735, "  ERRORLEVEL number Specifies a true condition if the last program run\r";
 736, "                    returned an exit code equal to or greater than the\r";
 737, "                    number specified.\r";
 738, "  command           Specifies the command to carry out if the condition is\r";
 739, "                    met.\r";
 740, "  string1==string2  Specifies a true condition if the specified text\r";
 741, "                    strings match.\r";
 742, "  EXIST filename    Specifies a true condition if the specified filename\r";
 743, "                    exists.\r";
 744, "Loads a program into the upper memory area.\r";
 745, "\r";
 746, "LOADHIGH [drive:][path]filename [parameters]\r";
 747, "LOADHIGH [/L:region1[,minsize1][;region2[,minsize2]...] [/S]]\r";
 748, "         [drive:][path]filename [parameters]\r";
 749, "\r";
 750, "/L:region1[,minsize1][;region2[,minsize2]]...\r";
 751, "            Specifies the region(s) of memory into which to load the\r";
 752, "            program.  Region1 specifies the number of the first memory\r";
 753, "            region; minsize1 specifies the minimum size, if any, for\r";
 754, "            region1.  Region2 and minsize2 specify the number and minimum\r";
 755, "            size of the second region, if any.  You can specify as many\r";
 756, "            regions as you want.\r";
 757, "\r";
 758, "/S          Shrinks a UMB to its minimum size while the program is\r";
 759, "            loading.\r";
 760, "\r";
 761, "[drive:][path]filename\r";
 762, "            Specifies the location and name of the program.\r";
 763, "Loads a program above the first 64K of memory, and runs the program.\r";
 764, "\r";
 765, "LOADFIX [drive:][path]filename\r";
 766, "\r";
 767, "Use LOADFIX to load a program if you have received the message \"Packed\r";
 768, "file corrupt\" when trying to load it in low memory.\r";
 769, "Creates a directory.\r";
 770, "\r";
 771, "MKDIR [drive:]path\r";
 772, "MD [drive:]path\r";
 773, "Displays or sets a search path for executable files.\r";
 774, "\r";
 775, "PATH [[drive:]path[;...]]\r";
 776, "PATH ;\r";
 777, "\r";
 778, "Type PATH ; to clear all search-path settings and direct the command shell\r";
 779, "to search only in the current directory.\r";
 780, "Type PATH without parameters to display the current path.\r";
 781, "Suspends processing of a batch program and displays the message:\r";
 782, "\"Press any key to continue....\" or an optional specified message.\r";
 783, "\r";
 784, "PAUSE [message]\r";
 785, "Changes the command prompt.\r";
 786, "\r";
 787, "PROMPT [text]\r";
 788, "\r";
 789, "  text    Specifies a new command prompt.\r";
 790, "\r";
 791, "Prompt can be made up of normal characters and the following special\r";
 792, "codes:\r";
 793, "\r";
 794, "  $Q   = (equal sign)\r";
 795, "  $$   $ (dollar sign)\r";
 796, "  $T   Current time\r";
 797, "  $D   Current date\r";
 798, "  $P   Current drive and path\r";
 799, "  $V   the FreeDOS command shell version number\r";
 800, "  $N   Current drive\r";
 801, "  $G   > (greater-than sign)\r";
 802, "  $L   < (less-than sign)\r";
 803, "  $B   | (pipe)\r";
 804, "  $H   Backspace (erases previous character)\r";
 805, "  $E   Escape code (ASCII code 27)\r";
 806, "  $_   Carriage return and linefeed\r";
 807, "\r";
 808, "Type PROMPT without parameters to reset the prompt to the default setting.\r";
 809, "Pushes current directory onto the directory stack, with the option to\r";
 810, "change current working directory.\r";
 811, "\r";
 812, "PUSHD [[drive:]path]\r";
 813, "  Where [drive:]path is a path to which you wish to change.\r";
 814, "Pops a directory off of the directory stack, and changes to it.\r";
 815, "\r";
 816, "POPD [*]\r";
 817, "  The '*' parameter clears the directory stack.\r";
 818, "Displays the contents of the directory stack.\r";
 819, "\r";
 820, "DIRS\r";
 821, "Removes (deletes) a directory.\r";
 822, "\r";
 823, "RMDIR [drive:]path\r";
 824, "RD [drive:]path\r";
 825, "Records comments (remarks) in a batch file or CONFIG.SYS.\r";
 826, "\r";
 827, "REM [comment]\r";
 828, "Renames a file/directory or files/directories.\r";
 829, "\r";
 830, "RENAME [drive:][path][directoryname1 | filename1] [directoryname2 | filename2]\r";
 831, "REN [drive:][path][directoryname1 | filename1] [directoryname2 | filename2]\r";
 832, "\r";
 833, "Note that you cannot specify a new drive or path for your destination. Use\r";
 834, "the MOVE command for that purpose.\r";
 835, "Displays, sets, or removes environment variables.\r";
 836, "\r";
 837, "SET [/C] [/P] [variable=[string]]\r";
 838, "\r";
 839, "  variable  Specifies the environment-variable name.\r";
 840, "  string    Specifies a series of characters to assign to the variable.\r";
 841, "\r";
 842, "* If no string is specified, the variable is removed from the environment.\r";
 843, "\r";
 844, "Type SET without parameters to display the current environment variables.\r";
 845, "\r";
 846, "/C forces to keep the case of the variable; by default the variable is\r";
 847, "uppercased, if it is not located in the environment already, otherwise\r";
 848, "the case is retained.\r";
 849, "\r";
 850, "/P prompt the user with string, and assigns the user input to the variable.\r";
 851, "Changes the position of replaceable parameters in a batch file.\r";
 852, "\r";
 853, "SHIFT [DOWN]\r";
 854, "\r";
 855, "DOWN shifts the argument window toward the beginning (%0); otherwise\r";
 856, "toward the end.\r";
 857, "Displays or sets the system time.\r";
 858, "\r";
 859, "TIME [/T] [time]\r";
 860, "\r";
 861, "Type TIME with no parameters to display the current time setting and a\r";
 862, "prompt for a new one.  Press ENTER to keep the same time.\r";
 863, "\r";
 864, "/T prevents TIME from becoming interactive.\r";
 865, "Displays the full path name of the path specified.\r";
 866, "\r";
 867, "TRUENAME [drive:][path][filename]\r";
 868, "Displays the contents of text files.\r";
 869, "\r";
 870, "TYPE [drive:][path]filename\r";
 871, "Displays the FreeDOS command shell version and other information.\r";
 872, "\r";
 873, "VER [/R] [/W] [/D] [/C]\r";
 874, "\r";
 875, " /R         Shows kernel version and other information.\r";
 876, " /W         FreeDOS command shell warranty.\r";
 877, " /D         FreeDOS command shell redistribution information.\r";
 878, " /C         FreeDOS command shell contributors.\r";
 879, "Tells the FreeDOS file system whether to verify that your files are\r";
 880, "written correctly to a disk.\r";
 881, "\r";
 882, "VERIFY [ON | OFF]\r";
 883, "\r";
 884, "Type VERIFY without a parameter to display the current VERIFY setting.\r";
 885, "If debugging is compiled into FreeDOS, this command will turn debug\r";
 886, "output on or off, or tell you if it is on or off.\r";
 887, "\r";
 888, "FDDEBUG [ON | OFF | file]\r";
 889, "\r";
 890, "Type FDDEBUG without a parameter to display the current debug output\r";
 891, "setting.\r";
 892, "If a file is specified, all debug output is redirected into that file;\r";
 893, "the output is appended to the file, if it already exists. The special\r";
 894, "names \"stdout\" and \"stderr\" may be used to redirect the output\r";
 895, "to the standard output or standard error stream.\r";
 896, "Displays the disk volume label and serial number, if they exist.\r";
 897, "\r";
 898, "VOL [drive:]\r";
 899, "Displays a list of commands and features available with in the shell.\r";
 900, "\r";
 901, "?\r";
 902, "?command [argument]\r";
 903, "\r";
 904, "The first variant displays any available internal command and feature.\r";
 905, "The second one will prompt whether or not to execute the specified\r";
 906, "command as if trace mode would be active.\r";
 907, "Searches and displays the executable file for each specified command.\r";
 908, "\r";
 909, "WHICH command...\r";
 910, "Displays the internal memory used by FreeCOM internally.\r";
 911, "\r";
 912, "MEMORY\r";
 913, "\r";
 914, "The COPY destination must not contain plus ('+') characters.\r";
 915, "Deleting file \"%s\".\r";
 916, "Unable to write to file '%s';\r";
 917, "probably disc full? (%lu bytes required)\r";
 918, "copied %luKB/???KB\r";
 919, "copied %luKB/%luKB\r";
 920, "FreeCOM cannot be a device: \"%s\"\r";
 921, "This file is no valid FreeCOM or of an incompatible version:\r";
 922, "%s\r";
 923, "Failed to load the strings resource into memory, the location\r";
 924, "pointed to in %COMSPEC% seems to be invalid. Please specify another\r";
 925, "location of FreeCOM to try to load the strings from, e.g.:\r";
 926, "C:\\COMMAND.COM\r";
 927, "or just hit enter to cancel to load the strings.\r";
 928, "'%s' kan inte ha några parametrar\r";
 929, "(!) CTTY non Š stato ancora implementato.\r";
 930, "Entrez une nouvelle date (mm-jj-[aa]aa):\r";
 931, "(?) State per cancellare tutti i files presenti nella directory corrente.\r";
 932, "    Sei sicuro di voler continuare (Y/N)?";
 933, "\r";
 934, "(i) The FreeDOS Command Shell comes with ABSOLUTELY NO WARRANTY.\r";
 935, "    For details type: \"ver /w\". This is free software, and you are\r";
 936, "    welcome to redistribute it under certain conditions; type \"ver /d\"\r";
 937, "    for details.  Type \"ver /c\" for a listing of credits.\r";
 938, "\r";
 939, "    Send bug reports to commandgcfl.net.\r";
 940, "    Updates are available from http://www.gcfl.net/FreeDOS/command.com\r";
 941, "    Traduzione in italiano di Alessio P. (www.khet.net/freedos)\r";
 942, "(!) Errore nello spazio di ambiente, probabilmente spazio esaurito.\r";
 943, "(!) Non posso copiare un file su esso stesso.\r";
 944, "(i) Copyright (C) 1994-1998 Tim Norman and others.\r";
 945, "Especificaci¢n de variable no v lida.\r";
