 471, "Updates are available from http://freedos.sourceforge.net/freecom\r\n";
 472, "\r\n";
 473, "\r\n";
 474, "\r\n";
 475, "\r\n";
 476, "The shell is about to be terminated, though, this is\r\n";
 477, "\r\n";
 478, "forbidden (usually by enabling the \"/P\" option).\r\n";
 479, "\r\n";
 480, "You must reboot the system or, if this shell runs in\r\n";
 481, "\r\n";
 482, "a multitasking environment, terminate this process/task manually.\r\n";
 483, "\r\n";
 484, "FreeCOM executable not found.\r\n";
 485, "You must specify the complete path to COMMAND.COM\r\n";
 486, "as the first argument of COMMAND, for instance:\r\n";
 487, "C:\\FDOS\r\n";
 488, "Environment segment    : max %5u bytes; free %5u bytes\r\n";
 489, "Context segment        : max %5u bytes; free %5u bytes\r\n";
 490, "Heap                   : free %5lu bytes\r\n";
 491, "	Aliases        : limit %5u bytes, current %5u bytes, %5u items\r\n";
 492, "	History        : limit %5u bytes, current %5u bytes, %5u items\r\n";
 493, "	Directory stack: limit %5u bytes, current %5u bytes, %5u items\r\n";
 494, "	Last dir cache : used  %5u bytes, %5u items\r\n";
 495, "	Batch nesting  : used  %5u bytes, %5u items\r\n";
 496, "	Swapinfo       : used  %5u bytes, %5u items\r\n";
 497, "Failed to aquire current code page from system.\r\n";
 498, "Failed to change current code page.\r\n";
 499, "The current codepage is %u.\r\n";
 500, "The system codepage (properly) is: %u.\r\n";
 501, "Displays, sets, or removes aliases.\r\n";
 502, "\r\n";
 503, "ALIAS [variable[=][string]]\r\n";
 504, "\r\n";
 505, "	variable  Specifies the alias name.\r\n";
 506, "	string    Specifies a series of characters to assign to the alias.\r\n";
 507, "\r\n";
 508, "\r\n";
 509, "Type ALIAS without parameters to display the current aliases.\r\n";
 510, "Make a beep sound.\r\n";
 511, "Sets or clears extended CTRL+C checking.\r\n";
 512, "\r\n";
 513, "BREAK [ON | OFF]\r\n";
 514, "\r\n";
 515, "Type BREAK without a parameter to display the current BREAK setting.\r\n";
 516, "Calls one batch program from another.\r\n";
 517, "\r\n";
 518, "CALL [/S | /N] [/Y] [drive:][path]filename [batch-parameters]\r\n";
 519, "\r\n";
 520, "  batch-parameters   Specifies any command-line information required by\r\n";
 521, "                     the batch program.\r\n";
 522, "  /S enforces, /N denies swapping of FreeCOM.\r\n";
 523, "  /Y enables tracemode during execution of the command.\r\n";
 524, "Displays the name of or changes the current directory.\r\n";
 525, "\r\n";
 526, "CHDIR [drive:][path]\r\n";
 527, "CHDIR[..]\r\n";
 528, "CD [drive:][path]\r\n";
 529, "CD[..]\r\n";
 530, "CD -\r\n";
 531, "\r\n";
 532, "  ..   Specifies that you want to change to the parent directory.\r\n";
 533, "  -    If \"last directory\" feature is enabled, change to last directory.\r\n";
 534, "\r\n";
 535, "Type CD drive: to display the current directory in the specified drive.\r\n";
 536, "Type CD without parameters to display the current drive and directory.\r\n";
 537, "See also: CDD\r\n";
 538, "Displays the name of or changes the current directory and drive.\r\n";
 539, "\r\n";
 540, "CDD [drive:][path]\r\n";
 541, "CDD[..]\r\n";
 542, "\r\n";
 543, "  ..   Specifies that you want to change to the parent directory.\r\n";
 544, "  -    If \"last directory\" feature is enabled, change to last directory.\r\n";
 545, "\r\n";
 546, "If drive: is specified, the current working drive is changed; this\r\n";
 547, "is the only different to \"CHDIR\".\r\n";
 548, "Type CD without parameters to display the current drive and directory.\r\n";
 549, "Displays or sets the active code page number.\r\n";
 550, "\r\n";
 551, "CHCP [nnn]\r\n";
 552, "\r\n";
 553, "  nnn   Specifies a code page number.\r\n";
 554, "\r\n";
 555, "Type CHCP without a parameter to display the active code page number.\r\n";
 556, "Clears the screen.\r\n";
 557, "\r\n";
 558, "CLS\r\n";
 559, "Starts a new copy of the FreeDOS command shell.\r\n";
 560, "\r\n";
 561, "COMMAND [[drive:]path] [device] [/E:nnnnn] [/L:nnnn] [/U:nnn] [/P] [/MSG]\r\n";
 562, "                       [/LOW] [/Y [/[C|K] command]]\r\n";
 563, "  [drive:]path    Specifies the directory containing COMMAND.COM.\r\n";
 564, "  device          Specifies the device to use for command input and output.\r\n";
 565, "  /E:nnnnn        Sets the initial environment size to nnnnn bytes.\r\n";
 566, "                  (nnnnn should be between 256 and 32,768).\r\n";
 567, "  /L:nnnn         Specifies internal buffers length (requires /P as well).\r\n";
 568, "                  (nnnn should be between 128 and 1,024).\r\n";
 569, "  /U:nnn          Specifies the input buffer length (requires /P as well).\r\n";
 570, "                  (nnn should be between 128 and 255).\r\n";
 571, "  /P              Makes the new command shell permanent (can't exit).\r\n";
 572, "  /MSG            Stores all error messages in memory (requires /P as well).\r\n";
 573, "  /LOW            Forces the command shell to keep its resident data in\r\n";
 574, "                  low memory.\r\n";
 575, "  /Y              Steps through the batch program specified by /C or /K.\r\n";
 576, "  /C command      Executes the specified command and returns.\r\n";
 577, "  /K command      Executes the specified command and continues running.\r\n";
 578, "Copies one or more files to another location.\r\n";
 579, "\r\n";
 580, "COPY [/A | /B] source [/A | /B] [+ source [/A | /B] [+ ...]] [destination\r\n";
 581, "  [/A | /B]] [/V] [/Y | /-Y]\r\n";
 582, "\r\n";
 583, "  source       Specifies the file or files to be copied.\r\n";
 584, "  /A           Indicates an ASCII text file.\r\n";
 585, "  /B           Indicates a binary file.\r\n";
 586, "  destination  Specifies the directory and/or filename for the new file(s).\r\n";
 587, "  /V           Verifies that new files are written correctly.\r\n";
 588, "  /Y           Suppresses prompting to confirm you want to overwrite an\r\n";
 589, "               existing destination file.\r\n";
 590, "  /-Y          Causes prompting to confirm you want to overwrite an\r\n";
 591, "               existing destination file.\r\n";
 592, "\r\n";
 593, "The switch /Y may be preset in the COPYCMD environment variable.\r\n";
 594, "This may be overridden with /-Y on the command line.\r\n";
 595, "\r\n";
 596, "To append files, specify a single file for destination, but multiple files\r\n";
 597, "for source (using wildcards or file1+file2+file3 format).\r\n";
 598, "Changes the terminal device used to control your system.\r\n";
 599, "\r\n";
 600, "CTTY device\r\n";
 601, "\r\n";
 602, "  device   The terminal device you want to use, such as COM1.\r\n";
 603, "Displays or sets the date.\r\n";
 604, "\r\n";
 605, "DATE [/D] [date]\r\n";
 606, "\r\n";
 607, "Type DATE without parameters to display the current date setting and a\r\n";
 608, "prompt for a new one.  Press ENTER to keep the same date.\r\n";
 609, "\r\n";
 610, "/D prevents DATE to become interactive.\r\n";
 611, "Deletes one or more files.\r\n";
 612, "\r\n";
 613, "DEL [drive:][path]filename [/P] [/V]\r\n";
 614, "ERASE [drive:][path]filename [/P] [/V]\r\n";
 615, "\r\n";
 616, "  [drive:][path]filename  Specifies the file(s) to delete.  Specify multiple\r\n";
 617, "                          files by using wildcards.\r\n";
 618, "  /P	Prompts for confirmation before deleting each file.\r\n";
 619, "  /V	Displays all deleted files.\r\n";
 620, "Displays a list of files and subdirectories in a directory.\r\n";
 621, "\r\n";
 622, "DIR [drive:][path][filename] [/P] [/W] [/A[[:]attributes]]\r\n";
 623, "  [/O[[:]sortorder]] [/S] [/B] [/L] [/V]\r\n";
 624, "\r\n";
 625, "  [drive:][path][filename]\r\n";
 626, "            Specifies drive, directory, and/or files to list.\r\n";
 627, "            (Could be enhanced file specification or multiple filespecs.)\r\n";
 628, " /P         Pauses after each screenful of information.\r\n";
 629, " /W         Uses wide list format.\r\n";
 630, " /A         Displays files with specified attributes. (Defaults to /ADHSRA)\r\n";
 631, " attributes  D  Directories                R  Read-only files\r\n";
 632, "             H  Hidden files               A  Files ready for archiving\r\n";
 633, "             S  System files               -  Prefix meaning not\r\n";
 634, " /O         List by files in sorted order.\r\n";
 635, " sortorder   N  By name (alphabetic)       S  By size (smallest first)\r\n";
 636, "             E  By extension (alphabetic)  D  By date & time (earliest first)\r\n";
 637, "             G  Group directories first    -  Prefix to reverse order\r\n";
 638, "             U  Unsorted		   Defaults to /ONG\r\n";
 639, " /S         Displays files in specified directory and all subdirectories.\r\n";
 640, " /B         Uses bare format (no heading information or summary).\r\n";
 641, " /L         Uses lowercase.\r\n";
 642, " /Y or /4   Display 4-digit year.\r\n";
 643, "\r\n";
 644, "Switches may be preset in the DIRCMD environment variable.  Override\r\n";
 645, "preset switches by prefixing any switch with - (hyphen)--for example, /-W.\r\n";
 646, "The external DOSKEY utility had been incorporated into FreeCOM.\r\n";
 647, "Use cursor UP,& DOWN keys to recall the history and HISTORY to display it.\r\n";
 648, "Use cursor LEFT,& RIGHT and the END and HOME keys to navigate within\r\n";
 649, "the command line and toggle INSERT between overstrike and insert mode.\r\n";
 650, "Use the TAB key to complete the current word as filename; use it twice\r\n";
 651, "to show all matching files.\r\n";
 652, "Edits command lines, recalls command lines, and creates macros\r\n";
 653, "\r\n";
 654, "DOSKEY [/switch ...] [macroname=[text]]\r\n";
 655, "\r\n";
 656, "  /BUFSIZE:size Sets size of macro and command buffer            (default:512)\r\n";
 657, "  /ECHO:on|off  Enables/disables echo of macro expansions        (default:on)\r\n";
 658, "  /FILE:file    Specifies file containing a list of macros\r\n";
 659, "  /HISTORY      Displays all commands stored in memory\r\n";
 660, "  /INSERT       Inserts new characters into line when typing\r\n";
 661, "  /KEYSIZE:size Sets size of keyboard type-ahead buffer          (default:15)\r\n";
 662, "  /LINE:size    Sets maximum size of line edit buffer            (default:128)\r\n";
 663, "  /MACROS       Displays all DOSKey macros\r\n";
 664, "  /OVERSTRIKE   Overwrites new characters onto line when typing  (default)\r\n";
 665, "  /REINSTALL    Installs a new copy of DOSKey\r\n";
 666, "  macroname     Specifies a name for a macro you create\r\n";
 667, "  text          Specifies commands you want to assign to the macro\r\n";
 668, "\r\n";
 669, "  UP,DOWN arrows recall commands\r\n";
 670, "      Esc clears current command\r\n";
 671, "       F7 displays command history\r\n";
 672, "   Alt+F7 clears command history\r\n";
 673, "[chars]F8 searches for command beginning with [chars]\r\n";
 674, "       F9 selects a command by number\r\n";
 675, "  Alt+F10 clears macro definitions\r\n";
 676, "\r\n";
 677, "The following are special codes you can use in DOSKey macro definitions:\r\n";
 678, "  $T     Command separator: allows multiple commands in a macro\r\n";
 679, "  $1-$9  Batch parameters: equivalent to %1-%9 in batch programs\r\n";
 680, "  $*     Symbol replaced by everything following macro name on the command line\r\n";
 681, "Displays messages, or turns command-echoing on or off.\r\n";
 682, "\r\n";
 683, "  ECHO [ON | OFF]\r\n";
 684, "  ECHO [message]\r\n";
 685, "\r\n";
 686, "Type ECHO without parameters to display the current echo setting.\r\n";
 687, "Quits the FreeDOS command shell unless loaded with /P.\r\n";
 688, "\r\n";
 689, "EXIT\r\n";
 690, "Runs a specified command for each file in a set of files.\r\n";
 691, "\r\n";
 692, "FOR %variable IN (set) DO command [command-parameters]\r\n";
 693, "\r\n";
 694, "  %variable  Specifies a replaceable parameter.\r\n";
 695, "  (set)      Specifies a set of one or more files.  Wildcards may be used.\r\n";
 696, "  command    Specifies the command to carry out for each file.\r\n";
 697, "  command-parameters\r\n";
 698, "             Specifies parameters or switches for the specified command.\r\n";
 699, "\r\n";
 700, "To use the FOR command in a batch program, specify %%variable instead of\r\n";
 701, "%variable.\r\n";
 702, "\r\n";
 703, "For example:\r\n";
 704, "  FOR %f IN (---start--- a*.* ---end---) DO ECHO - %f -\r\n";
 705, "Directs the command shell to a labelled line in a batch program.\r\n";
 706, "\r\n";
 707, "GOTO label\r\n";
 708, "\r\n";
 709, "  label   Specifies a text string used in the batch program as a label.\r\n";
 710, "\r\n";
 711, "You type a label on a line by itself, beginning with a colon.\r\n";
 712, "History command.\r\n";
 713, "\r\n";
 714, "HISTORY [size]\r\n";
 715, "\r\n";
 716, "Without \"size\" the current contents of the command line history\r\n";
 717, "buffer is displayed.\r\n";
 718, "With the size, the size of the history buffer is changed.\r\n";
 719, "Performs conditional processing in batch programs.\r\n";
 720, "\r\n";
 721, "IF [NOT] ERRORLEVEL number command\r\n";
 722, "IF [NOT] string1==string2 command\r\n";
 723, "IF [NOT] EXIST filename command\r\n";
 724, "\r\n";
 725, "  NOT               Specifies that the command shell should carry out the\r\n";
 726, "                    command only if the condition is false.\r\n";
 727, "  ERRORLEVEL number Specifies a true condition if the last program run\r\n";
 728, "                    returned an exit code equal to or greater than the\r\n";
 729, "                    number specified.\r\n";
 730, "  command           Specifies the command to carry out if the condition is\r\n";
 731, "                    met.\r\n";
 732, "  string1==string2  Specifies a true condition if the specified text\r\n";
 733, "                    strings match.\r\n";
 734, "  EXIST filename    Specifies a true condition if the specified filename\r\n";
 735, "                    exists.\r\n";
 736, "Loads a program into the upper memory area.\r\n";
 737, "\r\n";
 738, "LOADHIGH [drive:][path]filename [parameters]\r\n";
 739, "LOADHIGH [/L:region1[,minsize1][;region2[,minsize2]...] [/S]]\r\n";
 740, "         [drive:][path]filename [parameters]\r\n";
 741, "\r\n";
 742, "/L:region1[,minsize1][;region2[,minsize2]]...\r\n";
 743, "            Specifies the region(s) of memory into which to load the\r\n";
 744, "            program.  Region1 specifies the number of the first memory\r\n";
 745, "            region; minsize1 specifies the minimum size, if any, for\r\n";
 746, "            region1.  Region2 and minsize2 specify the number and minimum\r\n";
 747, "            size of the second region, if any.  You can specify as many\r\n";
 748, "            regions as you want.\r\n";
 749, "\r\n";
 750, "/S          Shrinks a UMB to its minimum size while the program is\r\n";
 751, "            loading.\r\n";
 752, "\r\n";
 753, "[drive:][path]filename\r\n";
 754, "            Specifies the location and name of the program.\r\n";
 755, "Loads a program above the first 64K of memory, and runs the program.\r\n";
 756, "\r\n";
 757, "LOADFIX [drive:][path]filename\r\n";
 758, "\r\n";
 759, "Use LOADFIX to load a program if you have received the message \"Packed\r\n";
 760, "file corrupt\" when trying to load it in low memory.\r\n";
 761, "Creates a directory.\r\n";
 762, "\r\n";
 763, "MKDIR [drive:]path\r\n";
 764, "MD [drive:]path\r\n";
 765, "Displays or sets a search path for executable files.\r\n";
 766, "\r\n";
 767, "PATH [[drive:]path[;...]]\r\n";
 768, "PATH ;\r\n";
 769, "\r\n";
 770, "Type PATH ; to clear all search-path settings and direct the command shell\r\n";
 771, "to search only in the current directory.\r\n";
 772, "Type PATH without parameters to display the current path.\r\n";
 773, "Suspends processing of a batch program and displays the message:\r\n";
 774, "\"Press any key to continue....\" or an optional specified message.\r\n";
 775, "\r\n";
 776, "PAUSE [message]\r\n";
 777, "Changes the command prompt.\r\n";
 778, "\r\n";
 779, "PROMPT [text]\r\n";
 780, "\r\n";
 781, "  text    Specifies a new command prompt.\r\n";
 782, "\r\n";
 783, "Prompt can be made up of normal characters and the following special\r\n";
 784, "codes:\r\n";
 785, "\r\n";
 786, "  $Q   = (equal sign)\r\n";
 787, "  $$   $ (dollar sign)\r\n";
 788, "  $T   Current time\r\n";
 789, "  $D   Current date\r\n";
 790, "  $P   Current drive and path\r\n";
 791, "  $V   the FreeDOS command shell version number\r\n";
 792, "  $N   Current drive\r\n";
 793, "  $G   > (greater-than sign)\r\n";
 794, "  $L   < (less-than sign)\r\n";
 795, "  $B   | (pipe)\r\n";
 796, "  $H   Backspace (erases previous character)\r\n";
 797, "  $E   Escape code (ASCII code 27)\r\n";
 798, "  $_   Carriage return and linefeed\r\n";
 799, "\r\n";
 800, "Type PROMPT without parameters to reset the prompt to the default setting.\r\n";
 801, "Pushes current directory onto the directory stack, with the option to\r\n";
 802, "change current working directory.\r\n";
 803, "\r\n";
 804, "PUSHD [[drive:]path]\r\n";
 805, "  Where [drive:]path is a path to which you wish to change.\r\n";
 806, "Pops a directory off of the directory stack, and changes to it.\r\n";
 807, "\r\n";
 808, "POPD [*]\r\n";
 809, "  The '*' parameter clears the directory stack.\r\n";
 810, "Displays the contents of the directory stack.\r\n";
 811, "\r\n";
 812, "DIRS\r\n";
 813, "Removes (deletes) a directory.\r\n";
 814, "\r\n";
 815, "RMDIR [drive:]path\r\n";
 816, "RD [drive:]path\r\n";
 817, "Records comments (remarks) in a batch file or CONFIG.SYS.\r\n";
 818, "\r\n";
 819, "REM [comment]\r\n";
 820, "Renames a file/directory or files/directories.\r\n";
 821, "\r\n";
 822, "RENAME [drive:][path][directoryname1 | filename1] [directoryname2 | filename2]\r\n";
 823, "REN [drive:][path][directoryname1 | filename1] [directoryname2 | filename2]\r\n";
 824, "\r\n";
 825, "Note that you cannot specify a new drive or path for your destination. Use\r\n";
 826, "the MOVE command for that purpose.\r\n";
 827, "Displays, sets, or removes environment variables.\r\n";
 828, "\r\n";
 829, "SET [/C] [/P] [variable=[string]]\r\n";
 830, "\r\n";
 831, "  variable  Specifies the environment-variable name.\r\n";
 832, "  string    Specifies a series of characters to assign to the variable.\r\n";
 833, "\r\n";
 834, "* If no string is specified, the variable is removed from the environment.\r\n";
 835, "\r\n";
 836, "Type SET without parameters to display the current environment variables.\r\n";
 837, "\r\n";
 838, "/C forces to keep the case of the variable; by default the variable is\r\n";
 839, "uppercased, if it is not located in the environment already, otherwise\r\n";
 840, "the case is retained.\r\n";
 841, "\r\n";
 842, "/P prompt the user with string, and assigns the user input to the variable.\r\n";
 843, "Changes the position of replaceable parameters in a batch file.\r\n";
 844, "\r\n";
 845, "SHIFT [DOWN]\r\n";
 846, "\r\n";
 847, "DOWN shifts the argument window toward the beginning (%0); otherwise\r\n";
 848, "toward the end.\r\n";
 849, "Displays or sets the system time.\r\n";
 850, "\r\n";
 851, "TIME [/T] [time]\r\n";
 852, "\r\n";
 853, "Type TIME with no parameters to display the current time setting and a\r\n";
 854, "prompt for a new one.  Press ENTER to keep the same time.\r\n";
 855, "\r\n";
 856, "/T prevents TIME from becoming interactive.\r\n";
 857, "Displays the full path name of the path specified.\r\n";
 858, "\r\n";
 859, "TRUENAME [drive:][path][filename]\r\n";
 860, "Displays the contents of text files.\r\n";
 861, "\r\n";
 862, "TYPE [drive:][path]filename\r\n";
 863, "Displays the FreeDOS command shell version and other information.\r\n";
 864, "\r\n";
 865, "VER [/R] [/W] [/D] [/C]\r\n";
 866, "\r\n";
 867, " /R         Shows kernel version and other information.\r\n";
 868, " /W         FreeDOS command shell warranty.\r\n";
 869, " /D         FreeDOS command shell redistribution information.\r\n";
 870, " /C         FreeDOS command shell contributors.\r\n";
 871, "Tells the FreeDOS file system whether to verify that your files are\r\n";
 872, "written correctly to a disk.\r\n";
 873, "\r\n";
 874, "VERIFY [ON | OFF]\r\n";
 875, "\r\n";
 876, "Type VERIFY without a parameter to display the current VERIFY setting.\r\n";
 877, "If debugging is compiled into FreeDOS, this command will turn debug\r\n";
 878, "output on or off, or tell you if it is on or off.\r\n";
 879, "\r\n";
 880, "FDDEBUG [ON | OFF | file]\r\n";
 881, "\r\n";
 882, "Type FDDEBUG without a parameter to display the current debug output\r\n";
 883, "setting.\r\n";
 884, "If a file is specified, all debug output is redirected into that file;\r\n";
 885, "the output is appended to the file, if it already exists. The special\r\n";
 886, "names \"stdout\" and \"stderr\" may be used to redirect the output\r\n";
 887, "to the standard output or standard error stream.\r\n";
 888, "Displays the disk volume label and serial number, if they exist.\r\n";
 889, "\r\n";
 890, "VOL [drive:]\r\n";
 891, "Displays a list of commands and features available with in the shell.\r\n";
 892, "\r\n";
 893, "?\r\n";
 894, "?command [argument]\r\n";
 895, "\r\n";
 896, "The first variant displays any available internal command and feature.\r\n";
 897, "The second one will prompt whether or not to execute the specified\r\n";
 898, "command as if trace mode would be active.\r\n";
 899, "Searches and displays the executable file for each specified command.\r\n";
 900, "\r\n";
 901, "WHICH command...\r\n";
 902, "Displays the internal memory used by FreeCOM internally.\r\n";
 903, "\r\n";
 904, "MEMORY\r\n";
 905, "\r\n";
 906, "The COPY destination must not contain plus ('+') characters.\r\n";
 907, "Deleting file \"%s\".\r\n";
 908, "Unable to write to file '%s';\r\n";
 909, "probably disc full? (%lu bytes required)\r\n";
 910, "copied %luKB/???KB\r\n";
 911, "copied %luKB/%luKB\r\n";
 912, "FreeCOM cannot be a device: \"%s\"\r\n";
 913, "This file is no valid FreeCOM or of an incompatible version:\r\n";
 914, "%s\r\n";
 915, "Failed to load the strings resource into memory, the location\r\n";
 916, "pointed to in %COMSPEC% seems to be invalid. Please specify another\r\n";
 917, "location of FreeCOM to try to load the strings from, e.g.:\r\n";
 918, "C:\\COMMAND.COM\r\n";
 919, "or just hit enter to cancel to load the strings.\r\n";
 920, "Show harddrive partition information\r\n";
 921, "\r\n";
 922, "PART [/D] [disc]\r\n";
 923, "  [disc]          Show partitions on a specified disc\r\n";
 924, "  /D              Shows detailed information about partition tables\r\n";
 925, "Disc %d not found\r\n";
 926, "Disc %d %08lX BIOS sectors / cyl %04X, heads %04X\r\n";
 927, "Disc %d\r\n";
 928, "\r\n";
 929, "  DRV TYPE    SECTORS       FILESYS         TOTAL SIZE          FREE SIZE\r\n";
 930, "%d: -- No entry\r\n";
 931, "Remove harddrive partition\r\n";
 932, "\r\n";
 933, "RMPART [/Y] disc part\r\n";
 934, "  disc            Disc number\r\n";
 935, "  part            Partition number\r\n";
 936, "  /Y              Don't ask before removing partition\r\n";
 937, "Partition %d not found or invalid\r\n";
 938, "Removing drive %s\r\n";
 939, "Size: %s\r\n";
 940, "Removing partition %d on disc %d\r\n";
 941, "Size: %s\r\n";
 942, "YyNn\rDelete (Yes/No) ? ";
 943, "Make harddrive partition\r\n";
 944, "\r\n";
 945, "MKPART disc filesys size\r\n";
 946, "  disc            Disc number\r\n";
 947, "  filesys         Filesystem name\r\n";
 948, "  size            Partition size in MB\r\n";
 949, "\r\n";
 950, "Currently supported filesystem names are:\r\n";
 951, "FAT12, FAT16, FAT32, RDFS and FLASHFS\r\n";
 952, "Unable to create partition. Invalid size of filesystem name\r\n";
 953, "Init harddrive partition table and write RDOS bootloader\r\n";
 954, "\r\n";
 955, "INITHD /R disc\r\n";
 956, "  disc            Disc number\r\n";
 957, "  /R              Make RDOS normal boot as default\r\n";
 958, "'%s' kan inte ha n†gra parametrar\r\n";
