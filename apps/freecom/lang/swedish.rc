 623, " /Y or /4   Visa 4-siffriga †rtal.\r\n";
 624, "\r\n";
 625, "V„xlar kan f”rinst„llas med milj”variabeln DIRCMD.  \r\n";
 626, "sidos„tt dessa v„xlar med - (bindestreck), till exempel /-W.\r\n";
 627, "Det externa DOSKEY-verktyget finns inbyggt i FreeCOM.\r\n";
 628, "Anv„nd UPP- och NEDPIL f”r att †terkalla lagrade kommandon eller skriv HISTORY \r\n";
 629, "f”r att visa dem.\r\n";
 630, "Use cursor LEFT,& RIGHT and the END and HOME keys to navigate within\r\n";
 631, "the command line and toggle INSERT between overstrike and insert mode.\r\n";
 632, "Tryck TAB f”r att komplettera aktuellt ord som filnamn; tryck tv† g†nger f”r \r\n";
 633, "att visa alla matchande filer.\r\n";
 634, "Redigerar kommandorader, †terkallar kommandorader, och skapar makron\r\n";
 635, "\r\n";
 636, "DOSKEY [/v„xel ...] [makronamn=[text]]\r\n";
 637, "\r\n";
 638, "  /BUFSIZE:storlek Anger storlek p† makro- och kommandobufferten    (standard:512)\r\n";
 639, "  /ECHO:ON|OFF     Anger ECHO ON/OFF i makron                       (standard:ON)\r\n";
 640, "  /FILE:fil        Anger fil med lista ”ver makron\r\n";
 641, "  /HISTORY         Visar alla kommandon som lagrats i minnet\r\n";
 642, "  /INSERT          S„tter in nya tecken i raden n„r ni skriver\r\n";
 643, "  /KEYSIZE:storlek Anger storleken p† tangentbordets type-ahead-buffert (standard:15)\r\n";
 644, "  /LINE:storlek    Anger maximal storlek p† radredigerings buffert  (standard:128)\r\n";
 645, "  /MACROS          Visar alla DOSKey-makron\r\n";
 646, "  /OVERSTRIKE      Skriver ”ver gamla tecken med nya n„r ni skriver (standard)\r\n";
 647, "  /REINSTALL       Installerar en ny kopia av DOSKey\r\n";
 648, "  makronamn        Namnet p† makrot som skapas\r\n";
 649, "  text             Kommandon som ni vill ha i makron\r\n";
 650, "\r\n";
 651, "UPP- och NEDPIL †terkallar kommandon\r\n";
 652, "            ESC tar bort aktuellt kommando\r\n";
 653, "             F7 visar lagrade kommandon\r\n";
 654, "         Alt+F7 tar bort lagrade kommandon\r\n";
 655, "     [tecken]F8 s”ker efter kommando som b”rjar med [tecken]\r\n";
 656, "             F9 v„ljer kommando med nummer\r\n";
 657, "        Alt+F10 rensar alla makrodefinitioner\r\n";
 658, "\r\n";
 659, "Specialkoder ni kan använda i DOSKey makrodefinitioner:\r\n";
 660, "  $T     Kommando separator: till†ter flera kommandon i samma makro\r\n";
 661, "  $1-$9  Batch-parametrar: likv„rdiga med %1-%9 i batch-program\r\n";
 662, "  $*     Utvidgad till allt som st†r p† kommandoraden efter makrots namn\r\n";
 663, "Visar meddelanden, eller styr hurvida kommandon som k”rs ska visas visas p\r\n";
 664, "sk„rmen.\r\n";
 665, "\r\n";
 666, "  ECHO [ON | OFF]\r\n";
 667, "  ECHO [meddelande]\r\n";
 668, "\r\n";
 669, "ECHO utan parametrar visar aktuell ECHO-inst„llning.\r\n";
 670, "Avslutar FreeDOS kommandoprompt.\r\n";
 671, "\r\n";
 672, "EXIT\r\n";
 673, "K”r angivet kommando f”r varje fil i en grupp av filer.\r\n";
 674, "\r\n";
 675, "FOR %variabel IN (grupp) DO kommando [kommandoparametrar]\r\n";
 676, "\r\n";
 677, "  %variabel  Anger en utbytbar parameter.\r\n";
 678, "  (grupp)    Anger en eller flera filer. Jokertecken f†r anv„ndas.\r\n";
 679, "  kommando   Anger kommandot som ska utf”ras f”r varje fil.\r\n";
 680, "  kommandoparametrar\r\n";
 681, "             Anger parametrar och/eller v„xlar f”r det angivna kommandot.\r\n";
 682, "\r\n";
 683, "F”r att anv„nda FOR kommandot i ett batch-program, ange %%variabel ist„llet\r\n";
 684, "f”r %variabel.\r\n";
 685, "Styr kommandoprompten till en rad med givnen etikett i ett batch-program.\r\n";
 686, "\r\n";
 687, "GOTO etikett\r\n";
 688, "\r\n";
 689, "  etikett    Anger en textstr„ng som anv„nds i batch-programmet som etikett.\r\n";
 690, "\r\n";
 691, "Ni skriver etiketten f”r sig sj„lv p† en rad, med ett kolon f”re.\r\n";
 692, "Tidigare-kommandot.\r\n";
 693, "\r\n";
 694, "HISTORY [storlek]\r\n";
 695, "\r\n";
 696, "Utan \"storlek\" visas det aktuella inneh†llet i kommandopromptens tidigare-buffer.\r\n";
 697, "Med \"storlek\" s† „ndras tidigare-bufferns storlek.\r\n";
 698, "K”r ett kommando i ett kommandoprogram om ett vilkor „r sant.\r\n";
 699, "\r\n";
 700, "IF [NOT] ERRORLEVEL tal kommando\r\n";
 701, "IF [NOT] str„ng1==str„ng2 kommando\r\n";
 702, "IF [NOT] EXIST filnamn kommando\r\n";
 703, "\r\n";
 704, "  NOT               Anger att komandoprompten ska utf”ra kommandot bara \r\n";
 705, "                    om vilkoret är falskt.                   \r\n";
 706, "  ERRORLEVEL tal    Anger att vilkoret „r sant om det sista programmet som \r\n";
 707, "                    k”rts returnerat en slutkod som „r lika med eller st”rre \r\n";
 708, "                    „n det angivna talet.\r\n";
 709, "  kommando          Anger ett kommando som ska utf”ras om vilkoret har uppn†tts.\r\n";
 710, "  str„ng1==str„ng2  Anger att villkoret „r sant om de angivna textstr„ngarna \r\n";
 711, "                    „r lika.\r\n";
 712, "  EXIST filnamn     Anger att villkortet „r sant om det angivna filnamnet existerar.\r\n";
 713, "Laddar ett program till det ”vre minnesomr†det.\r\n";
 714, "\r\n";
 715, "LOADHIGH [enhet:][s”kv„g]filnamn [parametrar]\r\n";
 716, "LOADHIGH [/L:region1[,minstorlek1][;region2[,minstorlek2]...] [/S]]\r\n";
 717, "         [enhet:][s”kv„g]filnamn [parametrar]\r\n";
 718, "\r\n";
 719, "/L:region1[,minstorlek1][;region2[,minstorlek2]]...\r\n";
 720, "            Anger de regioner av minnet dit programmet ska laddas.  \r\n";
 721, "            Region1 Anger numret f”r den f”rsta minnesregionen; minstorlek1 \r\n";
 722, "            anger minimistorleken, om n†gon, f”r region1.  \r\n";
 723, "            Region2 and minstorlek2 anger nummer och minimistorlek\r\n";
 724, "            f”r den andra regionen osv.\r\n";
 725, "            Ni kan ange hur m†nga regioner ni vill.\r\n";
 726, "\r\n";
 727, "/S          Krymper en UMB till minimal storlek medans programmet laddas.\r\n";
 728, "\r\n";
 729, "[enhet:][s”kv„g]filnamn\r\n";
 730, "            Anger plats och namn f”r programmet.\r\n";
 731, "Laddar ett program ovanf”r de f”rsta 64K i minnet, och k”r programmet.\r\n";
 732, "\r\n";
 733, "LOADFIX [enhet:][s”kv„g]filnamn\r\n";
 734, "\r\n";
 735, "Anv„nd LOADFIX f”r att ladda ett program om ni har f†tt meddelandet \r\n";
 736, "\"Packad fil korrupt\" n„r det laddas i det l„gre minnesomr†det.\r\n";
 737, "Skapar en katalog.\r\n";
 738, "\r\n";
 739, "MKDIR [enhet:]s”kv„g\r\n";
 740, "MD [enhet:]s”kv„g\r\n";
 741, "Visar eller anger de kataloger i vilka FreeCOM s”ker efter k”rbara filer.\r\n";
 742, "\r\n";
 743, "PATH [[enhet:]s”kv„g[;...]]\r\n";
 744, "PATH ;\r\n";
 745, "\r\n";
 746, "Skriv PATH ; om ni vill rensa alla s”kv„gsinst„llningar \r\n";
 747, "och bara s”ka i den aktuella katalogen.\r\n";
 748, "PATH utan parametrar visar aktuell s”kväg.\r\n";
 749, "Avbryter bearbetningen av ett kommandoprogram och visar meddelandet:\r\n";
 750, "\"Tryck p† valfri tangent f”r att forts„tta...\" eller valfritt eget meddelande.\r\n";
 751, "\r\n";
 752, "PAUSE [meddelande]\r\n";
 753, "Žndrar kommandoprompten.\r\n";
 754, "\r\n";
 755, "PROMPT [text]\r\n";
 756, "\r\n";
 757, "  text    Best„mmer den nya promptens utseende.\r\n";
 758, "\r\n";
 759, "Prompten kan best† av vanliga tecken och f”ljande specialtecken:\r\n";
 760, "\r\n";
 761, "  $Q   = (lika med-tecken)\r\n";
 762, "  $$   $ (dollartecken)\r\n";
 763, "  $T   Aktuell tid\r\n";
 764, "  $D   Aktuellt datum\r\n";
 765, "  $P   Aktuell enhet och s”kväg\r\n";
 766, "  $V   FreeDOS kommandoprompts versionsnumber\r\n";
 767, "  $N   Aktuell enhet\r\n";
 768, "  $G   > (st”rre „n-tecken)\r\n";
 769, "  $L   < (mindre „n-tecken)\r\n";
 770, "  $B   | (vertikalstreck)\r\n";
 771, "  $H   Backsteg (raderar f”reg†ende tecken)\r\n";
 772, "  $E   Escape-tecken (ASCII-kod 27)\r\n";
 773, "  $_   Vagnretur och ny rad\r\n";
 774, "\r\n";
 775, "PROMPT utan parametrar †terst„ller promptens standardutseende.\r\n";
 776, "L„gger nuvarande katalog till katalogstacken, med valet att\r\n";
 777, "„ndra nuvarande arbetskatalog.\r\n";
 778, "\r\n";
 779, "PUSHD [[enhet:]s”kv„g]\r\n";
 780, "  D„r [enhet:]s”kv„g „r en s”kv„g till det ni vill „ndra.\r\n";
 781, "Tar en katalog fr†n katalogstacken, och „ndras till den.\r\n";
 782, "\r\n";
 783, "POPD [*]\r\n";
 784, "  Jockertecken ('*') parametern rensar katalogstacken.\r\n";
 785, "Visar inneh†llet i en katalog.\r\n";
 786, "\r\n";
 787, "DIRS\r\n";
 788, "Tar bort en katalog.\r\n";
 789, "\r\n";
 790, "RMDIR [enhet:]s”kv„g\r\n";
 791, "RD [enhet:]s”kv„g\r\n";
 792, "Markerar kommentarer i ett kommandoprogram eller CONFIG.SYS.\r\n";
 793, "\r\n";
 794, "REM [kommentar]\r\n";
 795, "Byter namn p† en eller flera filer/kataloger.\r\n";
 796, "\r\n";
 797, "RENAME [enhet:][s”kv„g][katalognamn1 | filnamn1] [katalognamn2 | filnamn2]\r\n";
 798, "REN [enhet:][s”kv„g][katalognamn1 | filnamn1] [katalognamn2 | filnamn2]\r\n";
 799, "\r\n";
 800, "Ni kan inte ange enhet eller s”kv„g för m†lfil/katalog. \r\n";
 801, "Anv„nd kommandot MOVE f”r detta syfte.\r\n";
 802, "Visar, anger eller tar bort milj”variabler.\r\n";
 803, "\r\n";
 804, "SET [/C] [/P] [variabel=[str„ng]]\r\n";
 805, "\r\n";
 806, "  variabel  Anger milj”variabelns namn.\r\n";
 807, "  str„ng    Anger en serie tecken som tilldelas variabeln\r\n";
 808, "\r\n";
 809, "* Om ingen str„ng anges tas angiven milj”variabel bort.\r\n";
 810, "\r\n";
 811, "SET utan parametrar visar aktuella milj”variabler.\r\n";
 812, "\r\n";
 813, "/C tvingar SET att behålla information om gemener och VERSALER i variabelnamn;\r\n";
 814, "som standard s† omvanlas alla gemener till versaler om milj”variabeln inte \r\n";
 815, "redan finns, g”r den det s† beh†ller den sitt namn.\r\n";
 816, "\r\n";
 817, "/P Fr†gar anv„ndaren efter en str„ng som sen ges till variabeln.\r\n";
 818, "Žndrar numreringen av de utbytbara parametrarna i kommandoprogram.\r\n";
 819, "\r\n";
 820, "SHIFT [DOWN]\r\n";
 821, "\r\n";
 822, "DOWN Flyttar parameter mot b”rjan (%0); annars mot slutet.\r\n";
 823, "Visar eller st„ller in systemklockan.\r\n";
 824, "\r\n";
 825, "TIME [/T] [tid]\r\n";
 826, "\r\n";
 827, "Skriv TIME utan parametrar f”r att visa nuvarande tidsinst„llning och fr†ga \r\n";
 828, "efter ny inst„llning.  Tryck RETUR f”r att beh†lla samma tid.\r\n";
 829, "\r\n";
 830, "/T hindrar TIME fr†n att bli interaktiv.\r\n";
 831, "Visar hela s”kv„gen f”r given s”kv„g.\r\n";
 832, "\r\n";
 833, "TRUENAME [enhet:][s”kv„g][filnamn]\r\n";
 834, "Visar inneh†llet i textfiler.\r\n";
 835, "\r\n";
 836, "TYPE [enhet:][s”kv„g]filnamn\r\n";
 837, "Visar FreeDOS kommandoprompt version och annan information.\r\n";
 838, "\r\n";
 839, "VER [/R] [/W] [/D] [/C]\r\n";
 840, "\r\n";
 841, " /R         Visar kernel-version och annan information.\r\n";
 842, " /W         FreeDOS kommandoprompt garanti.\r\n";
 843, " /D         FreeDOS kommandoprompt omdistributions information.\r\n";
 844, " /C         FreeDOS kommandoprompt medhj„lpare.\r\n";
 845, "S„ger †t FreeDOS-filsystemet att verifiera att data skrivs korrekt p† disken.\r\n";
 846, "\r\n";
 847, "VERIFY [ON | OFF]\r\n";
 848, "\r\n";
 849, "Skriv VERIFY utan parametrar f”r att visa nuvarande VERIFY-inst„llning.\r\n";
 850, "Om debug (fels”kning) „r inkompilerat i FreeDOS, s† kan detta kommando\r\n";
 851, "st„nga av eller sl† p† utmatning av debug-information, \r\n";
 852, "eller visa om det „r ON eller OFF.\r\n";
 853, "\r\n";
 854, "FDDEBUG [ON | OFF | fil]\r\n";
 855, "\r\n";
 856, "Skriv FDDEBUG utan parameter f”r att visa nuvarande inst„llningar\r\n";
 857, "f”r utmatning av debug-information.\r\n";
 858, "Om en fil specifiseras kommer all debug-information att skickas till den filen;\r\n";
 859, "utmatningen l„ggs till sist i filen, om den redan finns. De speciella\r\n";
 860, "namnen \"stdout\" och \"stderr\" kan anv„ndas f”r att vidarebefodra utmatningen \r\n";
 861, "till standard out eller standard error stream.\r\n";
 862, "Visar diskens volymetikett och serienummer, om de finns.\r\n";
 863, "\r\n";
 864, "VOL [enhet:]\r\n";
 865, "Visar en lista p† kommandon och funktioner som finns tillgängliga i prompten.\r\n";
 866, "\r\n";
 867, "?\r\n";
 868, "?command [parameter]\r\n";
 869, "\r\n";
 870, "Den f”rsta varianten visar tillg„ngliga interna kommandon och funktioner.\r\n";
 871, "Den andra kommer fr†ga om det givna kommandot ska k”ras som om\r\n";
 872, "trace-l„ge vore aktiverat.\r\n";
 873, "\r\n";
 874, "S”ker och visar den exekverbara filen f”r varje givet kommando.\r\n";
 875, "\r\n";
 876, "WHICH {kommando}\r\n";
 877, "Visar det interna minnet som anv„nds av FreeCOM internt\r\n";
 878, "\r\n";
 879, "MEMORY\r\n";
 880, "\r\n";
 881, "M†let f”r COPY f†r inte inneh†lla plus ('+') tecken.\r\n";
 882, "Tar bort fil \"%s\".\r\n";
 883, "Unable to write to file '%s';\r\n";
 884, "probably disc full? (%lu bytes required)\r\n";
 885, "copied %luKB/???KB\r\n";
 886, "copied %luKB/%luKB\r\n";
 887, "FreeCOM cannot be a device: \"%s\"\r\n";
 888, "This file is no valid FreeCOM or of an incompatible version:\r\n";
 889, "%s\r\n";
 890, "Failed to load the strings resource into memory, the location\r\n";
 891, "pointed to in %COMSPEC% seems to be invalid. Please specify another\r\n";
 892, "location of FreeCOM to try to load the strings from, e.g.:\r\n";
 893, "C:\\COMMAND.COM\r\n";
 894, "or just hit enter to cancel to load the strings.\r\n";
 895, "Visar h†rddiskpartitioner\r\n";
 896, "\r\n";
 897, "SHOWPART /D [disc]\r\n";
 898, "  [disc]          Anger en specifik disk\r\n";
 899, "  /D              Visar detaljerad information om partitionstabeller\r\n";
 900, "Disc %d not found\r\n";
 901, "Disc %d %08lX BIOS sectors / cyl %04X, heads %04X\r\n";
 902, "Disc %d\r\n";
 903, "\r\n";
 904, "  DRV TYPE    SECTORS       FILESYS         TOTAL SIZE          FREE SIZE\r\n";
 905, "%d: -- No entry\r\n";
 906, "Remove harddrive partition\r\n";
 907, "\r\n";
 908, "RMPART [/Y] disc part\r\n";
 909, "  disc            Disc number\r\n";
 910, "  part            Partition number\r\n";
 911, "  /Y              Don't ask before removing partition\r\n";
 912, "Partition %d not found or invalid\r\n";
 913, "Removing drive %s\r\n";
 914, "Size: %s\r\n";
 915, "Removing partition %d on disc %d\r\n";
 916, "Size: %s\r\n";
 917, "YyNn\rDelete (Yes/No) ? ";
 918, "Make harddrive partition\r\n";
 919, "\r\n";
 920, "MKPART disc filesys size\r\n";
 921, "  disc            Disc number\r\n";
 922, "  filesys         Filesystem name\r\n";
 923, "  size            Partition size in MB\r\n";
 924, "\r\n";
 925, "Currently supported filesystem names are:\r\n";
 926, "FAT12, FAT16, FAT32, RDFS and FLASHFS\r\n";
 927, "Unable to create partition. Invalid size of filesystem name\r\n";
 928, "Init harddrive partition table and write RDOS bootloader\r\n";
 929, "\r\n";
 930, "INITHD /R disc\r\n";
 931, "  disc            Disc number\r\n";
 932, "  /R              Make RDOS normal boot as default\r\n";
 933, "Not enough free sectors at the begining of disc %d\r\n";
 934, "'%s' kan inte ha n†gra parametrar\r\n";
