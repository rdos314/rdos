 1684, "Size: %s\r\n";
 1685, "YyNn\rDelete (Yes/No) ? ";
 1686, "Make harddrive partition\r\n";
 1687, "\r\n";
 1688, "MKPART disc filesys size\r\n";
 1689, "  disc            Disc number\r\n";
 1690, "  filesys         Filesystem name\r\n";
 1691, "  size            Partition size in MB\r\n";
 1692, "\r\n";
 1693, "Currently supported filesystem names are:\r\n";
