 1382, "             S  Systemfiler                -  Prefix f”r inte\r\n";
 1383, " /O         Ger lista enligt sortorder.\r\n";
 1384, " sortorder   N  Efter namn (alfabetisk)    S  Efter storlek (minst f”rst)\r\n";
 1385, "             E  Efter till„gg (alfabetisk) D  Datum och tid (äldst f”rst)\r\n";
 1386, "             G  Gruppera kataloger f”rst   -  Prefix f”r omv„nd ordning\r\n";
 1387, "             U  Osorterade		      (Standard „r /ONG)\r\n";
 1388, " /S         Visar filer i angiven katalog och filerna i dess underkataloger.\r\n";
 1389, " /B         Enkelt format (Ingen inledande information och sammanfattning).\r\n";
 1390, " /L         Anv„nder gemener.\r\n";
 1391, " /Y or /4   Visa 4-siffriga †rtal.\r\n";
 1392, "\r\n";
 1393, "V„xlar kan f”rinst„llas med milj”variabeln DIRCMD.  \r\n";
 1394, "sidos„tt dessa v„xlar med - (bindestreck), till exempel /-W.\r\n";
 1395, "Det externa DOSKEY-verktyget finns inbyggt i FreeCOM.\r\n";
 1396, "Anv„nd UPP- och NEDPIL f”r att †terkalla lagrade kommandon eller skriv HISTORY \r\n";
 1397, "f”r att visa dem.\r\n";
 1398, "Use cursor LEFT,& RIGHT and the END and HOME keys to navigate within\r\n";
 1399, "the command line and toggle INSERT between overstrike and insert mode.\r\n";
 1400, "Tryck TAB f”r att komplettera aktuellt ord som filnamn; tryck tv† g†nger f”r \r\n";
 1401, "att visa alla matchande filer.\r\n";
 1402, "Redigerar kommandorader, †terkallar kommandorader, och skapar makron\r\n";
 1403, "\r\n";
 1404, "DOSKEY [/v„xel ...] [makronamn=[text]]\r\n";
 1405, "\r\n";
 1406, "  /BUFSIZE:storlek Anger storlek p† makro- och kommandobufferten    (standard:512)\r\n";
 1407, "  /ECHO:ON|OFF     Anger ECHO ON/OFF i makron                       (standard:ON)\r\n";
 1408, "  /FILE:fil        Anger fil med lista ”ver makron\r\n";
 1409, "  /HISTORY         Visar alla kommandon som lagrats i minnet\r\n";
 1410, "  /INSERT          S„tter in nya tecken i raden n„r ni skriver\r\n";
 1411, "  /KEYSIZE:storlek Anger storleken p† tangentbordets type-ahead-buffert (standard:15)\r\n";
 1412, "  /LINE:storlek    Anger maximal storlek p† radredigerings buffert  (standard:128)\r\n";
 1413, "  /MACROS          Visar alla DOSKey-makron\r\n";
 1414, "  /OVERSTRIKE      Skriver ”ver gamla tecken med nya n„r ni skriver (standard)\r\n";
 1415, "  /REINSTALL       Installerar en ny kopia av DOSKey\r\n";
 1416, "  makronamn        Namnet p† makrot som skapas\r\n";
 1417, "  text             Kommandon som ni vill ha i makron\r\n";
 1418, "\r\n";
 1419, "UPP- och NEDPIL †terkallar kommandon\r\n";
 1420, "            ESC tar bort aktuellt kommando\r\n";
 1421, "             F7 visar lagrade kommandon\r\n";
 1422, "         Alt+F7 tar bort lagrade kommandon\r\n";
 1423, "     [tecken]F8 s”ker efter kommando som b”rjar med [tecken]\r\n";
 1424, "             F9 v„ljer kommando med nummer\r\n";
 1425, "        Alt+F10 rensar alla makrodefinitioner\r\n";
 1426, "\r\n";
 1427, "Specialkoder ni kan använda i DOSKey makrodefinitioner:\r\n";
 1428, "  $T     Kommando separator: till†ter flera kommandon i samma makro\r\n";
 1429, "  $1-$9  Batch-parametrar: likv„rdiga med %1-%9 i batch-program\r\n";
 1430, "  $*     Utvidgad till allt som st†r p† kommandoraden efter makrots namn\r\n";
 1431, "Visar meddelanden, eller styr hurvida kommandon som k”rs ska visas visas p\r\n";
 1432, "sk„rmen.\r\n";
 1433, "\r\n";
 1434, "  ECHO [ON | OFF]\r\n";
 1435, "  ECHO [meddelande]\r\n";
 1436, "\r\n";
 1437, "ECHO utan parametrar visar aktuell ECHO-inst„llning.\r\n";
 1438, "Avslutar FreeDOS kommandoprompt.\r\n";
 1439, "\r\n";
 1440, "EXIT\r\n";
 1441, "K”r angivet kommando f”r varje fil i en grupp av filer.\r\n";
 1442, "\r\n";
 1443, "FOR %variabel IN (grupp) DO kommando [kommandoparametrar]\r\n";
 1444, "\r\n";
 1445, "  %variabel  Anger en utbytbar parameter.\r\n";
 1446, "  (grupp)    Anger en eller flera filer. Jokertecken f†r anv„ndas.\r\n";
 1447, "  kommando   Anger kommandot som ska utf”ras f”r varje fil.\r\n";
 1448, "  kommandoparametrar\r\n";
 1449, "             Anger parametrar och/eller v„xlar f”r det angivna kommandot.\r\n";
 1450, "\r\n";
 1451, "F”r att anv„nda FOR kommandot i ett batch-program, ange %%variabel ist„llet\r\n";
 1452, "f”r %variabel.\r\n";
 1453, "Styr kommandoprompten till en rad med givnen etikett i ett batch-program.\r\n";
 1454, "\r\n";
 1455, "GOTO etikett\r\n";
 1456, "\r\n";
 1457, "  etikett    Anger en textstr„ng som anv„nds i batch-programmet som etikett.\r\n";
 1458, "\r\n";
 1459, "Ni skriver etiketten f”r sig sj„lv p† en rad, med ett kolon f”re.\r\n";
 1460, "Tidigare-kommandot.\r\n";
 1461, "\r\n";
 1462, "HISTORY [storlek]\r\n";
 1463, "\r\n";
 1464, "Utan \"storlek\" visas det aktuella inneh†llet i kommandopromptens tidigare-buffer.\r\n";
 1465, "Med \"storlek\" s† „ndras tidigare-bufferns storlek.\r\n";
 1466, "K”r ett kommando i ett kommandoprogram om ett vilkor „r sant.\r\n";
 1467, "\r\n";
 1468, "IF [NOT] ERRORLEVEL tal kommando\r\n";
 1469, "IF [NOT] str„ng1==str„ng2 kommando\r\n";
 1470, "IF [NOT] EXIST filnamn kommando\r\n";
 1471, "\r\n";
 1472, "  NOT               Anger att komandoprompten ska utf”ra kommandot bara \r\n";
 1473, "                    om vilkoret är falskt.                   \r\n";
 1474, "  ERRORLEVEL tal    Anger att vilkoret „r sant om det sista programmet som \r\n";
 1475, "                    k”rts returnerat en slutkod som „r lika med eller st”rre \r\n";
 1476, "                    „n det angivna talet.\r\n";
 1477, "  kommando          Anger ett kommando som ska utf”ras om vilkoret har uppn†tts.\r\n";
 1478, "  str„ng1==str„ng2  Anger att villkoret „r sant om de angivna textstr„ngarna \r\n";
 1479, "                    „r lika.\r\n";
 1480, "  EXIST filnamn     Anger att villkortet „r sant om det angivna filnamnet existerar.\r\n";
 1481, "Laddar ett program till det ”vre minnesomr†det.\r\n";
 1482, "\r\n";
 1483, "LOADHIGH [enhet:][s”kv„g]filnamn [parametrar]\r\n";
 1484, "LOADHIGH [/L:region1[,minstorlek1][;region2[,minstorlek2]...] [/S]]\r\n";
 1485, "         [enhet:][s”kv„g]filnamn [parametrar]\r\n";
 1486, "\r\n";
 1487, "/L:region1[,minstorlek1][;region2[,minstorlek2]]...\r\n";
 1488, "            Anger de regioner av minnet dit programmet ska laddas.  \r\n";
 1489, "            Region1 Anger numret f”r den f”rsta minnesregionen; minstorlek1 \r\n";
 1490, "            anger minimistorleken, om n†gon, f”r region1.  \r\n";
 1491, "            Region2 and minstorlek2 anger nummer och minimistorlek\r\n";
 1492, "            f”r den andra regionen osv.\r\n";
 1493, "            Ni kan ange hur m†nga regioner ni vill.\r\n";
 1494, "\r\n";
 1495, "/S          Krymper en UMB till minimal storlek medans programmet laddas.\r\n";
 1496, "\r\n";
 1497, "[enhet:][s”kv„g]filnamn\r\n";
 1498, "            Anger plats och namn f”r programmet.\r\n";
 1499, "Laddar ett program ovanf”r de f”rsta 64K i minnet, och k”r programmet.\r\n";
 1500, "\r\n";
 1501, "LOADFIX [enhet:][s”kv„g]filnamn\r\n";
 1502, "\r\n";
 1503, "Anv„nd LOADFIX f”r att ladda ett program om ni har f†tt meddelandet \r\n";
 1504, "\"Packad fil korrupt\" n„r det laddas i det l„gre minnesomr†det.\r\n";
 1505, "Skapar en katalog.\r\n";
 1506, "\r\n";
 1507, "MKDIR [enhet:]s”kv„g\r\n";
 1508, "MD [enhet:]s”kv„g\r\n";
 1509, "Visar eller anger de kataloger i vilka FreeCOM s”ker efter k”rbara filer.\r\n";
 1510, "\r\n";
 1511, "PATH [[enhet:]s”kv„g[;...]]\r\n";
 1512, "PATH ;\r\n";
 1513, "\r\n";
 1514, "Skriv PATH ; om ni vill rensa alla s”kv„gsinst„llningar \r\n";
 1515, "och bara s”ka i den aktuella katalogen.\r\n";
 1516, "PATH utan parametrar visar aktuell s”kväg.\r\n";
 1517, "Avbryter bearbetningen av ett kommandoprogram och visar meddelandet:\r\n";
 1518, "\"Tryck p† valfri tangent f”r att forts„tta...\" eller valfritt eget meddelande.\r\n";
 1519, "\r\n";
 1520, "PAUSE [meddelande]\r\n";
 1521, "Žndrar kommandoprompten.\r\n";
 1522, "\r\n";
 1523, "PROMPT [text]\r\n";
 1524, "\r\n";
 1525, "  text    Best„mmer den nya promptens utseende.\r\n";
 1526, "\r\n";
 1527, "Prompten kan best† av vanliga tecken och f”ljande specialtecken:\r\n";
 1528, "\r\n";
 1529, "  $Q   = (lika med-tecken)\r\n";
 1530, "  $$   $ (dollartecken)\r\n";
 1531, "  $T   Aktuell tid\r\n";
 1532, "  $D   Aktuellt datum\r\n";
 1533, "  $P   Aktuell enhet och s”kväg\r\n";
 1534, "  $V   FreeDOS kommandoprompts versionsnumber\r\n";
 1535, "  $N   Aktuell enhet\r\n";
 1536, "  $G   > (st”rre „n-tecken)\r\n";
 1537, "  $L   < (mindre „n-tecken)\r\n";
 1538, "  $B   | (vertikalstreck)\r\n";
 1539, "  $H   Backsteg (raderar f”reg†ende tecken)\r\n";
 1540, "  $E   Escape-tecken (ASCII-kod 27)\r\n";
 1541, "  $_   Vagnretur och ny rad\r\n";
 1542, "\r\n";
 1543, "PROMPT utan parametrar †terst„ller promptens standardutseende.\r\n";
 1544, "L„gger nuvarande katalog till katalogstacken, med valet att\r\n";
 1545, "„ndra nuvarande arbetskatalog.\r\n";
 1546, "\r\n";
 1547, "PUSHD [[enhet:]s”kv„g]\r\n";
 1548, "  D„r [enhet:]s”kv„g „r en s”kv„g till det ni vill „ndra.\r\n";
 1549, "Tar en katalog fr†n katalogstacken, och „ndras till den.\r\n";
 1550, "\r\n";
 1551, "POPD [*]\r\n";
 1552, "  Jockertecken ('*') parametern rensar katalogstacken.\r\n";
 1553, "Visar inneh†llet i en katalog.\r\n";
 1554, "\r\n";
 1555, "DIRS\r\n";
 1556, "Tar bort en katalog.\r\n";
 1557, "\r\n";
 1558, "RMDIR [enhet:]s”kv„g\r\n";
 1559, "RD [enhet:]s”kv„g\r\n";
 1560, "Markerar kommentarer i ett kommandoprogram eller CONFIG.SYS.\r\n";
 1561, "\r\n";
 1562, "REM [kommentar]\r\n";
 1563, "Byter namn p† en eller flera filer/kataloger.\r\n";
 1564, "\r\n";
 1565, "RENAME [enhet:][s”kv„g][katalognamn1 | filnamn1] [katalognamn2 | filnamn2]\r\n";
 1566, "REN [enhet:][s”kv„g][katalognamn1 | filnamn1] [katalognamn2 | filnamn2]\r\n";
 1567, "\r\n";
 1568, "Ni kan inte ange enhet eller s”kv„g för m†lfil/katalog. \r\n";
 1569, "Anv„nd kommandot MOVE f”r detta syfte.\r\n";
 1570, "Visar, anger eller tar bort milj”variabler.\r\n";
 1571, "\r\n";
 1572, "SET [/C] [/P] [variabel=[str„ng]]\r\n";
 1573, "\r\n";
 1574, "  variabel  Anger milj”variabelns namn.\r\n";
 1575, "  str„ng    Anger en serie tecken som tilldelas variabeln\r\n";
 1576, "\r\n";
 1577, "* Om ingen str„ng anges tas angiven milj”variabel bort.\r\n";
 1578, "\r\n";
 1579, "SET utan parametrar visar aktuella milj”variabler.\r\n";
 1580, "\r\n";
 1581, "/C tvingar SET att behålla information om gemener och VERSALER i variabelnamn;\r\n";
 1582, "som standard s† omvanlas alla gemener till versaler om milj”variabeln inte \r\n";
 1583, "redan finns, g”r den det s† beh†ller den sitt namn.\r\n";
 1584, "\r\n";
 1585, "/P Fr†gar anv„ndaren efter en str„ng som sen ges till variabeln.\r\n";
 1586, "Žndrar numreringen av de utbytbara parametrarna i kommandoprogram.\r\n";
 1587, "\r\n";
 1588, "SHIFT [DOWN]\r\n";
 1589, "\r\n";
 1590, "DOWN Flyttar parameter mot b”rjan (%0); annars mot slutet.\r\n";
 1591, "Visar eller st„ller in systemklockan.\r\n";
 1592, "\r\n";
 1593, "TIME [/T] [tid]\r\n";
 1594, "\r\n";
 1595, "Skriv TIME utan parametrar f”r att visa nuvarande tidsinst„llning och fr†ga \r\n";
 1596, "efter ny inst„llning.  Tryck RETUR f”r att beh†lla samma tid.\r\n";
 1597, "\r\n";
 1598, "/T hindrar TIME fr†n att bli interaktiv.\r\n";
 1599, "Visar hela s”kv„gen f”r given s”kv„g.\r\n";
 1600, "\r\n";
 1601, "TRUENAME [enhet:][s”kv„g][filnamn]\r\n";
 1602, "Visar inneh†llet i textfiler.\r\n";
 1603, "\r\n";
 1604, "TYPE [enhet:][s”kv„g]filnamn\r\n";
 1605, "Visar FreeDOS kommandoprompt version och annan information.\r\n";
 1606, "\r\n";
 1607, "VER [/R] [/W] [/D] [/C]\r\n";
 1608, "\r\n";
 1609, " /R         Visar kernel-version och annan information.\r\n";
 1610, " /W         FreeDOS kommandoprompt garanti.\r\n";
 1611, " /D         FreeDOS kommandoprompt omdistributions information.\r\n";
 1612, " /C         FreeDOS kommandoprompt medhj„lpare.\r\n";
 1613, "S„ger †t FreeDOS-filsystemet att verifiera att data skrivs korrekt p† disken.\r\n";
 1614, "\r\n";
 1615, "VERIFY [ON | OFF]\r\n";
 1616, "\r\n";
 1617, "Skriv VERIFY utan parametrar f”r att visa nuvarande VERIFY-inst„llning.\r\n";
 1618, "Om debug (fels”kning) „r inkompilerat i FreeDOS, s† kan detta kommando\r\n";
 1619, "st„nga av eller sl† p† utmatning av debug-information, \r\n";
 1620, "eller visa om det „r ON eller OFF.\r\n";
 1621, "\r\n";
 1622, "FDDEBUG [ON | OFF | fil]\r\n";
 1623, "\r\n";
 1624, "Skriv FDDEBUG utan parameter f”r att visa nuvarande inst„llningar\r\n";
 1625, "f”r utmatning av debug-information.\r\n";
 1626, "Om en fil specifiseras kommer all debug-information att skickas till den filen;\r\n";
 1627, "utmatningen l„ggs till sist i filen, om den redan finns. De speciella\r\n";
 1628, "namnen \"stdout\" och \"stderr\" kan anv„ndas f”r att vidarebefodra utmatningen \r\n";
 1629, "till standard out eller standard error stream.\r\n";
 1630, "Visar diskens volymetikett och serienummer, om de finns.\r\n";
 1631, "\r\n";
 1632, "VOL [enhet:]\r\n";
 1633, "Visar en lista p† kommandon och funktioner som finns tillgängliga i prompten.\r\n";
 1634, "\r\n";
 1635, "?\r\n";
 1636, "?command [parameter]\r\n";
 1637, "\r\n";
 1638, "Den f”rsta varianten visar tillg„ngliga interna kommandon och funktioner.\r\n";
 1639, "Den andra kommer fr†ga om det givna kommandot ska k”ras som om\r\n";
 1640, "trace-l„ge vore aktiverat.\r\n";
 1641, "\r\n";
 1642, "S”ker och visar den exekverbara filen f”r varje givet kommando.\r\n";
 1643, "\r\n";
 1644, "WHICH {kommando}\r\n";
 1645, "Visar det interna minnet som anv„nds av FreeCOM internt\r\n";
 1646, "\r\n";
 1647, "MEMORY\r\n";
 1648, "\r\n";
 1649, "M†let f”r COPY f†r inte inneh†lla plus ('+') tecken.\r\n";
 1650, "Tar bort fil \"%s\".\r\n";
 1651, "Unable to write to file '%s';\r\n";
 1652, "probably disc full? (%lu bytes required)\r\n";
 1653, "copied %luKB/???KB\r\n";
 1654, "copied %luKB/%luKB\r\n";
 1655, "FreeCOM cannot be a device: \"%s\"\r\n";
 1656, "This file is no valid FreeCOM or of an incompatible version:\r\n";
 1657, "%s\r\n";
 1658, "Failed to load the strings resource into memory, the location\r\n";
 1659, "pointed to in %COMSPEC% seems to be invalid. Please specify another\r\n";
 1660, "location of FreeCOM to try to load the strings from, e.g.:\r\n";
 1661, "C:\\COMMAND.COM\r\n";
 1662, "or just hit enter to cancel to load the strings.\r\n";
 1663, "Visar h†rddiskpartitioner\r\n";
 1664, "\r\n";
 1665, "SHOWPART /D [disc]\r\n";
 1666, "  [disc]          Anger en specifik disk\r\n";
 1667, "  /D              Visar detaljerad information om partitionstabeller\r\n";
 1668, "Disc %d not found\r\n";
 1669, "Disc %d %08lX BIOS sectors / cyl %04X, heads %04X\r\n";
 1670, "Disc %d\r\n";
 1671, "\r\n";
 1672, "  DRV TYPE    SECTORS       FILESYS         TOTAL SIZE          FREE SIZE\r\n";
 1673, "%d: -- No entry\r\n";
 1674, "Remove harddrive partition\r\n";
 1675, "\r\n";
 1676, "RMPART [/Y] disc part\r\n";
 1677, "  disc            Disc number\r\n";
 1678, "  part            Partition number\r\n";
 1679, "  /Y              Don't ask before removing partition\r\n";
 1680, "Partition %d not found or invalid\r\n";
 1681, "Removing drive %s\r\n";
 1682, "Size: %s\r\n";
