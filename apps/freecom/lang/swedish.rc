 469, "Uppdateringar finns tillgängliga på http://freedos.sourceforge.net/freecom\r";
 470, "\r";
 471, "\r";
 472, "\r";
 473, "\r";
 474, "Kommandoprompten håller på att avslutas, trots att detta\r";
 475, "\r";
 476, "är förbjudet (vanligtvis genom att använda \"/P\" växeln).\r";
 477, "\r";
 478, "Ni måste starta om datorn, eller om prompten körs i en \r";
 479, "\r";
 480, "multitasking miljö, stänga av processen manuellt.\r";
 481, "\r";
 482, "FreeCOMs programfil hittades inte.\r";
 483, "Ni måste ange fullständig sökväg till COMMAND.COM\r";
 484, "som första parameter i COMMAND, till exempel:\r";
 485, "C:\\FDOS\r";
 486, "Miljösegment    : max %5u byte; ledigt %5u byte\r";
 487, "Kontext-segment : max %5u byte; ledigt %5u byte\r";
 488, "Heap            : ledigt %5lu byte\r";
 489, "	Alias         : gräns %5u byte, nuvarande %5u byte, %5u objekt\r";
 490, "	Tidigare      : gräns %5u byte, nuvarande %5u byte, %5u objekt\r";
 491, "	Katalogstack  : gräns %5u byte, nuvarande %5u byte, %5u objekt\r";
 492, "	Föregående kat : använt  %5u byte, %5u objekt\r";
 493, "	Batch nesting  : använt  %5u byte, %5u objekt\r";
 494, "	Swappinfo       : använt  %5u byte, %5u objekt\r";
 495, "Kunde inte hämta codepage från systemet.\r";
 496, "Kunde inte ändra aktuellt codepage.\r";
 497, "Aktuell codepage är %u.\r";
 498, "Systemets codepage är: %u.\r";
 499, "Visar, anger eller tar bort alias.\r";
 500, "\r";
 501, "ALIAS [variabel[=][sträng]]\r";
 502, "\r";
 503, "	variabel  Anger namn på alias.\r";
 504, "	sträng    Anger en serie tecken som ges till alias.\r";
 505, "\r";
 506, "\r";
 507, "ALIAS utan parametrar visar aktuella alias.\r";
 508, "Gör ett pip-ljud.\r";
 509, "Anger eller tar bort utökad CTRL+C kontroll.\r";
 510, "\r";
 511, "BREAK [ON | OFF]\r";
 512, "\r";
 513, "BREAK utan parametrar visar aktuellt BREAK-inställning.\r";
 514, "Anropar ett batch-program från ett annat.\r";
 515, "\r";
 516, "CALL [/S | /N] [/Y] [enhet:][sökväg]filnamn [batch-parametrar]\r";
 517, "\r";
 518, "  batch-parametrar   Anger kommandorads-information som                                            batch-programmet behöver.                    \r";
 519, "  /S tvingar, /N förbjuder swappning av FreeCOM.\r";
 520, "  /Y aktiverar trace-läge under utförandet av kommandot.\r";
 521, "Visar namnet på, eller ändrar, aktuell katalog.\r";
 522, "\r";
 523, "CHDIR [enhet:][sökväg]\r";
 524, "CHDIR[..]\r";
 525, "CD [enhet:][sökväg]\r";
 526, "CD[..]\r";
 527, "CD -\r";
 528, "\r";
 529, "  ..   Anger att ni önskar ändra aktuell katalog moderkatalogen.\r";
 530, "  -    Om \"föregående katalog\"-funktionen är på byts aktuell katalog ut med          föregående katalog.\r";
 531, "\r";
 532, "CD enhet: visar vilken katalog som är den aktuella på angiven enhet.\r";
 533, "CD utan parametrar visar aktuell enhet och katalog.\r";
 534, "Se även: CDD\r";
 535, "Visar namnet på, eller ändrar, aktuell katalog och enhet.\r";
 536, "\r";
 537, "CDD [enhet:][sökväg]\r";
 538, "CDD[..]\r";
 539, "\r";
 540, "  ..   Anger att ni önskar ändra aktuell katalog moderkatalogen.\r";
 541, "  -    Om \"föregående katalog\"-funktionen är på byts aktuell katalog ut med          föregående katalog.\r";
 542, "\r";
 543, "Om enhet: anges ändras aktuell arbetsenhet; detta är den enda skillnaden \r";
 544, "jämfört mot \"CHDIR\".\r";
 545, "CDD utan parametrar visar aktuell enhet och katalog.\r";
 546, "Visar eller anger aktiv codepage-nummer.\r";
 547, "\r";
 548, "CHCP [nnn]\r";
 549, "\r";
 550, "  nnn   Anger ett codepage-nummer.\r";
 551, "\r";
 552, "CHCP utan parametrar visar aktivt codepage-nummer.\r";
 553, "Rensar skärmen.\r";
 554, "\r";
 555, "CLS\r";
 556, "Startar en ny kopia av FreeCOM kommandoprompt.\r";
 557, "\r";
 558, "COMMAND [[enhet:]sökväg] [enhet] [/E:nnnnn] [/L:nnnn] [/U:nnn] [/P] [/MSG]\r";
 559, "                       [/LOW] [/Y [/[C|K] kommando]]\r";
 560, "  [enhet:]sökväg  Anger sökväg som innehåller COMMAND.COM.\r";
 561, "  enhet           Anger en hårdvaruenhet att använda för indata och utdata.\r";
 562, "  /E:nnnnn        Anger startstorleken på miljön till nnnnn byte.\r";
 563, "                  (nnnnn bör vara mellan 256 och 32,768).\r";
 564, "  /L:nnnn         Anger längd på interna buffertar (kräver /P).\r";
 565, "                  (nnnn bör vara mellan 128 och 1,024).\r";
 566, "  /U:nnn          Anger buffertlängd för indata (kräver /P).\r";
 567, "                  (nnn bör vara mellan 128 och 255).\r";
 568, "  /P              Gör den nya kommandoprompten permanent (kan ej avslutas).\r";
 569, "  /MSG            Lagrar alla felmeddelanden i minnet (kräver /P).\r";
 570, "  /LOW            Resident data behålls i det låga minnesområdet.\r";
 571, "  /Y              Stegar igenom batch-programmet med /C eller /K.\r";
 572, "  /C kommando      Utför angivet kommando och återgår till programmet.\r";
 573, "  /K kommando      Utför angivet kommando och fortsätter köra..\r";
 574, "Koperar en eller flera filer till en annan plats\r";
 575, "\r";
 576, "COPY [/A | /B] källa [/A | /B] [+ källa [/A | /B] [+ ...]] [mål\r";
 577, "  [/A | /B]] [/V] [/Y | /-Y]\r";
 578, "\r";
 579, "  källa        Anger den eller de filer som ska kopieras.\r";
 580, "  /A           Indikerar att filen är en ASCII-textfil.\r";
 581, "  /B           Indikerar att filen är en binär fil.\r";
 582, "  källa        Anger katalog och/eller filnamn för de nya filerna.\r";
 583, "  /V           Verifierar att nya filer skrivs korrekt.\r";
 584, "  /Y           Bekräftelse krävs inte för att skriva över en befintlig fil\r";
 585, "  /-Y          Bekräftelse krävs för att skriva öven en befintlig fil\r";
 586, "\r";
 587, "Växeln /Y kan vara förinställd i miljövariabeln COPYCMD.\r";
 588, "Det kan åsidosättas med /-Y i kommandoraden\r";
 589, "\r";
 590, "Lägg ihop filer genom att ange en enstaka fil som mål men flera som källa (använd jokertecken eller formatet fil1+fil2+fil3).\r";
 591, "Ändrar den enhet som används för att kontrollera systemet.\r";
 592, "\r";
 593, "CTTY enhet\r";
 594, "\r";
 595, "  enhet   Enheten ni vill använda, t ex COM1.\r";
 596, "Visar eller anger datum\r";
 597, "\r";
 598, "DATE [/D] [datum]\r";
 599, "\r";
 600, "DATE utan parametrar visar aktuellt datum och frågar efter ett nytt.\r";
 601, "Tryck RETUR för att behålla samma datum.\r";
 602, "\r";
 603, "/D hindrar DATE från att bli interaktivt.\r";
 604, "Tar bort en eller flera filer.\r";
 605, "\r";
 606, "DEL [enhet:][sökväg]filnamn [/P] [/V]\r";
 607, "ERASE [enhet:][sökväg]filnamn [/P] [/V]\r";
 608, "\r";
 609, "  [enhet:][sökväg]filnamn Anger fil eller filer att ta bort. \r";
 610, "                          Flera filer anges med jokertecken.\r";
 611, "  /P	Kräver bekräftelse vid borttagning av fil.\r";
 612, "  /V	Visar alla borttagna filer.\r";
 613, "Visar en lista med filer och underkataloger i en katalog.\r";
 614, "\r";
 615, "DIR [enhet:][sökväg][filnamn] [/P] [/W] [/A[[:]attribut]]\r";
 616, "  [/O[[:]sortorder]] [/S] [/B] [/L] [/V]\r";
 617, "\r";
 618, "  [enhet:][sökväg][filnamn]\r";
 619, "            Anger enhet, katalog och/eller filer att visa.\r";
 620, "            (Kan vara utökad eller flertalig filspecifikation)\r";
 621, " /P         Visar en del i taget av listan, om denna inte ryms på skärmen.\r";
 622, " /W         Visar filer och kataloger i kolumner.\r";
 623, " /A         Visar endast filer med angivet attribut. (standard är /ADHSRA)\r";
 624, " attribut    D  Kataloger                  R  Skrivskyddade filer\r";
 625, "             H  Dolda filer                A  Arkivklara filer\r";
 626, "             S  Systemfiler                -  Prefix för inte\r";
 627, " /O         Ger lista enligt sortorder.\r";
 628, " sortorder   N  Efter namn (alfabetisk)    S  Efter storlek (minst först)\r";
 629, "             E  Efter tillägg (alfabetisk) D  Datum och tid (äldst först)\r";
 630, "             G  Gruppera kataloger först   -  Prefix för omvänd ordning\r";
 631, "             U  Osorterade		      (Standard är /ONG)\r";
 632, " /S         Visar filer i angiven katalog och filerna i dess underkataloger.\r";
 633, " /B         Enkelt format (Ingen inledande information och sammanfattning).\r";
 634, " /L         Använder gemener.\r";
 635, " /Y or /4   Visa 4-siffriga årtal.\r";
 636, "\r";
 637, "Växlar kanförinställas med miljövariabeln DIRCMD.  \r";
 638, "Åsidosätt dessa växlar med - (bindestreck), till exempel /-W.\r";
 639, "Det externa DOSKEY-verktyget finns inbyggt i FreeCOM.\r";
 640, "Använd UPP- och NEDPIL för att återkalla lagrade kommandon eller skriv HISTORY för att visa dem.\r";
 641, "Use cursor LEFT,& RIGHT and the END and HOME keys to navigate within\r";
 642, "the command line and toggle INSERT between overstrike and insert mode.\r";
 643, "Tryck TAB för att komplettera aktuellt ord som filnamn; tryck två gånger för att visa alla matchande filer.\r";
 644, "Redigerar kommandorader, återkallar kommandorader, och skapar makron\r";
 645, "\r";
 646, "DOSKEY [/växel ...] [makronamn=[text]]\r";
 647, "\r";
 648, "  /BUFSIZE:storlek Anger storlek på makro- och kommandobufferten    (standard:512)\r";
 649, "  /ECHO:ON|OFF     Anger ECHO ON/OFF i makron                       (standard:ON)\r";
 650, "  /FILE:fil        Anger fil med lista över makron\r";
 651, "  /HISTORY         Visar alla kommandon som lagrats i minnet\r";
 652, "  /INSERT          Sätter in nya tecken i raden när ni skriver\r";
 653, "  /KEYSIZE:storlek Anger storleken på tangentbordets type-ahead-buffert (standard:15)\r";
 654, "  /LINE:storlek    Anger maximal storlek på radredigerings buffert  (standard:128)\r";
 655, "  /MACROS          Visar alla DOSKey-makron\r";
 656, "  /OVERSTRIKE      Skriver över gamla tecken med nya när ni skriver (standard)\r";
 657, "  /REINSTALL       Installerar en ny kopia av DOSKey\r";
 658, "  makronamn        Namnet på makrot som skapas\r";
 659, "  text             Kommandon som ni vill ha i makron\r";
 660, "\r";
 661, "UPP- och NEDPIL återkallar kommandon\r";
 662, "            ESC tar bort aktuellt kommando\r";
 663, "             F7 visar lagrade kommandon\r";
 664, "         Alt+F7 tar bort lagrade kommandon\r";
 665, "     [tecken]F8 söker efter kommando som börjar med [tecken]\r";
 666, "             F9 väljer kommando med nummer\r";
 667, "        Alt+F10 rensar alla makrodefinitioner\r";
 668, "\r";
 669, "Specialkoder ni kan använda i DOSKey makrodefinitioner:\r";
 670, "  $T     Kommando separator: tillåter flera kommandon i samma makro\r";
 671, "  $1-$9  Batch-parametrar: likvärdiga med %1-%9 i batch-program\r";
 672, "  $*     Utvidgad till allt som står på kommandoraden efter makrots namn\r";
 673, "Visar meddelanden, eller styr hurvida kommandon som körs ska visas visas på skärmen.\r";
 674, "\r";
 675, "  ECHO [ON | OFF]\r";
 676, "  ECHO [meddelande]\r";
 677, "\r";
 678, "ECHO utan parametrar visar aktuell ECHO-inställning.\r";
 679, "Avslutar FreeDOS kommandoprompt.\r";
 680, "\r";
 681, "EXIT\r";
 682, "Kör angivet kommando för varje fil i en grupp av filer.\r";
 683, "\r";
 684, "FOR %variabel IN (grupp) DO kommando [kommandoparametrar]\r";
 685, "\r";
 686, "  %variabel  Anger en utbytbar parameter.\r";
 687, "  (grupp)    Anger en eller flera filer. Jokertecken får användas.\r";
 688, "  kommando   Anger kommandot som ska utföras för varje fil.\r";
 689, "  kommandoparametrar\r";
 690, "             Anger parametrar och/eller växlar för det angivna kommandot.\r";
 691, "\r";
 692, "För att använda FOR kommandot i ett batch-program, ange %%variabel istället\r";
 693, "för %variabel.\r";
 694, "Styr kommandoprompten till en rad med givnen etikett i ett batch-program.\r";
 695, "\r";
 696, "GOTO etikett\r";
 697, "\r";
 698, "  etikett    Anger en textsträng som används i batch-programmet som etikett.\r";
 699, "\r";
 700, "Ni skriver etiketten för sig själv på en rad, med ett kolon före.\r";
 701, "Tidigare-kommandot.\r";
 702, "\r";
 703, "HISTORY [storlek]\r";
 704, "\r";
 705, "Utan \"storlek\" visas det aktuella innehållet i kommandopromptens tidigare-buffer.\r";
 706, "Med \"storlek\" så ändras tidigare-bufferns storlek.\r";
 707, "Kör ett kommando i ett kommandoprogram om ett vilkor är sant.\r";
 708, "\r";
 709, "IF [NOT] ERRORLEVEL tal kommando\r";
 710, "IF [NOT] sträng1==sträng2 kommando\r";
 711, "IF [NOT] EXIST filnamn kommando\r";
 712, "\r";
 713, "  NOT               Anger att komandoprompten ska utföra kommandot bara \r";
 714, "                    om vilkoret är falskt.                   \r";
 715, "  ERRORLEVEL tal    Anger att vilkoret är sant om det sista programmet som \r";
 716, "                    körts returnerat en slutkod som är lika med eller större \r";
 717, "                    än det angivna talet.\r";
 718, "  kommando          Anger ett kommando som ska utföras om vilkoret har uppnåtts.\r";
 719, "  sträng1==sträng2  Anger att villkoret är sant om de angivna textsträngarna \r";
 720, "                    är lika.\r";
 721, "  EXIST filnamn     Anger att villkortet är sant om det angivna filnamnet existerar.\r";
 722, "Laddar ett program till det övre minnesområdet.\r";
 723, "\r";
 724, "LOADHIGH [enhet:][sökväg]filnamn [parametrar]\r";
 725, "LOADHIGH [/L:region1[,minstorlek1][;region2[,minstorlek2]...] [/S]]\r";
 726, "         [enhet:][sökväg]filnamn [parametrar]\r";
 727, "\r";
 728, "/L:region1[,minstorlek1][;region2[,minstorlek2]]...\r";
 729, "            Anger de regioner av minnet dit programmet ska laddas.  \r";
 730, "            Region1 Anger numret för den första minnesregionen; minstorlek1 \r";
 731, "            anger minimistorleken, om någon, för region1.  \r";
 732, "            Region2 and minstorlek2 anger nummer och minimistorlek\r";
 733, "            för den andra regionen osv.\r";
 734, "            Ni kan ange hur många regioner ni vill.\r";
 735, "\r";
 736, "/S          Krymper en UMB till minimal storlek medans programmet laddas.\r";
 737, "\r";
 738, "[enhet:][sökväg]filnamn\r";
 739, "            Anger plats och namn för programmet.\r";
 740, "Laddar ett program ovanför de första 64K i minnet, och kör programmet.\r";
 741, "\r";
 742, "LOADFIX [enhet:][sökväg]filnamn\r";
 743, "\r";
 744, "Använd LOADFIX för att ladda ett program om ni har fått meddelandet \r";
 745, "\"Packad fil korrupt\" när det laddas i det lägre minnesområdet.\r";
 746, "Skapar en katalog.\r";
 747, "\r";
 748, "MKDIR [enhet:]sökväg\r";
 749, "MD [enhet:]sökväg\r";
 750, "Visar eller anger de kataloger i vilka FreeCOM söker efter körbara filer.\r";
 751, "\r";
 752, "PATH [[enhet:]sökväg[;...]]\r";
 753, "PATH ;\r";
 754, "\r";
 755, "Skriv PATH ; om ni vill rensa alla sökvägsinställningar \r";
 756, "och bara söka i den aktuella katalogen.\r";
 757, "PATH utan parametrar visar aktuell sökväg.\r";
 758, "Avbryter bearbetningen av ett kommandoprogram och visar meddelandet:\r";
 759, "\"Tryck på valfri tangent för att fortsätta...\" eller valfritt eget meddelande.\r";
 760, "\r";
 761, "PAUSE [meddelande]\r";
 762, "Ändrar kommandoprompten.\r";
 763, "\r";
 764, "PROMPT [text]\r";
 765, "\r";
 766, "  text    Bestämmer den nya promptens utseende.\r";
 767, "\r";
 768, "Prompten kan bestå av valiga tecken och följande specialtecken:\r";
 769, "\r";
 770, "  $Q   = (lika med-tecken)\r";
 771, "  $$   $ (dollartecken)\r";
 772, "  $T   Aktuell tid\r";
 773, "  $D   Aktuellt datum\r";
 774, "  $P   Aktuell enhet och sökväg\r";
 775, "  $V   FreeDOS kommandoprompts versionsnumber\r";
 776, "  $N   Aktuell enhet\r";
 777, "  $G   > (större än-tecken)\r";
 778, "  $L   < (mindre än-tecken)\r";
 779, "  $B   | (vertikalstreck)\r";
 780, "  $H   Backsteg (raderar föregående tecken)\r";
 781, "  $E   Escape-tecken (ASCII-kod 27)\r";
 782, "  $_   Vagnretur och ny rad\r";
 783, "\r";
 784, "PROMPT utan parametrar återställer promptens standardutseende.\r";
 785, "Lägger nuvarande katalog till katalogstacken, med valet att\r";
 786, "ändra nuvarande arbetskatalog.\r";
 787, "\r";
 788, "PUSHD [[enhet:]sökväg]\r";
 789, "  Där [enhet:]sökväg är en sökväg till det ni vill ändra.\r";
 790, "Tar en katalog från katalogstacken, och ändras till den.\r";
 791, "\r";
 792, "POPD [*]\r";
 793, "  Jockertecken ('*') parametern rensar katalogstacken.\r";
 794, "Visar innehållet i en katalog.\r";
 795, "\r";
 796, "DIRS\r";
 797, "Tar bort en katalog.\r";
 798, "\r";
 799, "RMDIR [enhet:]sökväg\r";
 800, "RD [enhet:]sökväg\r";
 801, "Markerar kommentarer i ett kommandoprogram eller CONFIG.SYS.\r";
 802, "\r";
 803, "REM [kommentar]\r";
 804, "Byter namn på en eller flera filer/kataloger.\r";
 805, "\r";
 806, "RENAME [enhet:][sökväg][katalognamn1 | filnamn1] [katalognamn2 | filnamn2]\r";
 807, "REN [enhet:][sökväg][katalognamn1 | filnamn1] [katalognamn2 | filnamn2]\r";
 808, "\r";
 809, "Ni kan inte ange enhet eller sökväg för målfil/katalog. \r";
 810, "Använd kommandot MOVE för detta syfte.\r";
 811, "Visar, anger eller tar bort miljövariabler.\r";
 812, "\r";
 813, "SET [/C] [/P] [variabel=[sträng]]\r";
 814, "\r";
 815, "  variabel  Anger miljövariabelns namn.\r";
 816, "  sträng    Anger en serie tecken som tilldelas variabeln\r";
 817, "\r";
 818, "* Om ingen sträng anges tas angiven möljövariabel bort.\r";
 819, "\r";
 820, "SET utan parametrar visar aktuella miljövariabler.\r";
 821, "\r";
 822, "/C tvingar SET att behålla information om gemener och VERSALER i variabelnamn; som standard så omvanlas alla gemener till versaler om miljövariabeln inte redan finns, gör den det så behåller den sitt namn.\r";
 823, "\r";
 824, "/P Frågar användaren efter en sträng som sen ges till variabeln.\r";
 825, "Ändrar numreringen av de utbytbara parametrarna i kommandoprogram.\r";
 826, "\r";
 827, "SHIFT [DOWN]\r";
 828, "\r";
 829, "DOWN Flyttar parameter mot början (%0); annars mot slutet.\r";
 830, "Visar eller ställer in systemklockan.\r";
 831, "\r";
 832, "TIME [/T] [tid]\r";
 833, "\r";
 834, "Skriv TIME utan parametrar för att visa nuvarande tidsinställning och fråga \r";
 835, "efter ny inställning.  Tryck RETUR för att behålla samma tid.\r";
 836, "\r";
 837, "/T hindrar TIME från att bli interaktiv.\r";
 838, "Visar hela sökvägen för given sökväg.\r";
 839, "\r";
 840, "TRUENAME [enhet:][sökväg][filnamn]\r";
 841, "Visar innehållet i textfiler.\r";
 842, "\r";
 843, "TYPE [enhet:][sökväg]filnamn\r";
 844, "Visar FreeDOS kommandoprompt version och annan information.\r";
 845, "\r";
 846, "VER [/R] [/W] [/D] [/C]\r";
 847, "\r";
 848, " /R         Visar kernel-version och annan information.\r";
 849, " /W         FreeDOS kommandoprompt garanti.\r";
 850, " /D         FreeDOS kommandoprompt omdistributions information.\r";
 851, " /C         FreeDOS kommandoprompt medhjälpare.\r";
 852, "Säger åt FreeDOS-filsystemet att verifiera att data skrivs korrekt på disken.\r";
 853, "\r";
 854, "VERIFY [ON | OFF]\r";
 855, "\r";
 856, "Skriv VERIFY utan parametrar för att visa nuvarande VERIFY-inställning.\r";
 857, "Om debug (felsökning) är inkompilerat i FreeDOS, så kan detta kommando\r";
 858, "stänga av eller slå på utmatning av debug-information, \r";
 859, "eller visa om det är ON eller OFF.\r";
 860, "\r";
 861, "FDDEBUG [ON | OFF | fil]\r";
 862, "\r";
 863, "Skriv FDDEBUG utan parameter för att visa nuvarande inställningar\r";
 864, "för utmatning av debug-information.\r";
 865, "Om en fil specifiseras kommer all debug-information att skickas till den filen;\r";
 866, "utmatningen läggs till sist i filen, om den redan finns. De speciella\r";
 867, "namnen \"stdout\" och \"stderr\" kan användas för att vidarebefodra utmatningen \r";
 868, "till standard out eller standard error stream.\r";
 869, "Visar diskens volymetikett och serienummer, om de finns.\r";
 870, "\r";
 871, "VOL [enhet:]\r";
 872, "Visar en lista på kommandon och funktioner som finns tillgängliga i prompten.\r";
 873, "\r";
 874, "?\r";
 875, "?command [parameter]\r";
 876, "\r";
 877, "Den första varianten visar tillgängliga interna kommandon och funktioner.\r";
 878, "Den andra kommer fråga om det givna kommandot ska köras som om\r";
 879, "trace-läge vore aktiverat.\r";
 880, "\r";
 881, "Söker och visar den exekverbara filen för varje givet kommando.\r";
 882, "\r";
 883, "WHICH {kommando}\r";
 884, "Visar det interna minnet som används av FreeCOM internt\r";
 885, "\r";
 886, "MEMORY\r";
 887, "\r";
 888, "Målet för COPY får inte innehålla plus ('+') tecken.\r";
 889, "Tar bort fil \"%s\".\r";
 890, "Unable to write to file '%s';\r";
 891, "probably disc full? (%lu bytes required)\r";
 892, "copied %luKB/???KB\r";
 893, "copied %luKB/%luKB\r";
 894, "FreeCOM cannot be a device: \"%s\"\r";
 895, "This file is no valid FreeCOM or of an incompatible version:\r";
 896, "%s\r";
 897, "Failed to load the strings resource into memory, the location\r";
 898, "pointed to in %COMSPEC% seems to be invalid. Please specify another\r";
 899, "location of FreeCOM to try to load the strings from, e.g.:\r";
 900, "C:\\COMMAND.COM\r";
 901, "or just hit enter to cancel to load the strings.\r";
 902, "'%s' kan inte ha några parametrar\r";
